# Copy to .env.local for local development (Vercel CLI) and set the real
# values as Vercel Environment Variables for the deployed project. Never
# commit an actual filled-in .env/.env.local file.

# From the Shopify custom app's API credentials page (Partner Dashboard).
# Used for: App Proxy signature verification (diagnostic-only as of Phase
# A.2, see api/proxy/identity.js), webhook HMAC verification. NOT used for
# the Customer Account OAuth token exchange -- that is a public PKCE client
# (see [customer_authentication] in shopify-app/shopify.app.toml) and must
# never send a client secret.
#
# Also usable, together with SHOPIFY_CLIENT_ID below, as the
# client_credentials grant for lib/shopify-admin-client.js's internal admin
# dashboard learner-identity lookup (Customer ID -> name/email) -- but ONLY
# once this app's Admin API scopes include `read_customers`, which they do
# NOT as of this writing (see shopify-app/shopify.app.toml; current scopes
# are write_app_proxy + the unrelated Customer Account API scope
# customer_read_customers). Adding that scope requires a
# `shopify app deploy` and the store re-approving the expanded grant --
# never do this without that explicit, separate authorization step. Until
# then, the lookup is configured (this secret + SHOPIFY_CLIENT_ID already
# exist) but every call fails closed with a scope-denied error and the
# dashboard falls back to showing the numeric customer ID, by design.
SHOPIFY_API_SECRET=

# The app's OAuth client_id, from shopify-app/shopify.app.toml (`shopify app
# config link` output). Not a secret -- a public PKCE client's client_id is
# inherently exposed in the browser's redirect to Shopify -- but still kept
# in env config rather than hardcoded so it isn't duplicated across files.
SHOPIFY_CLIENT_ID=095af359420e5400dc385150e9b4c8e4

# The store this backend serves (its .myshopify.com domain). Used to reject
# a session token minted for a different shop, and to validate shop/redact
# payloads. Distinct from SHOP_STOREFRONT_DOMAIN below -- OIDC discovery is
# served from the storefront domain, not the myshopify.com one.
SHOPIFY_SHOP_DOMAIN=a44b34.myshopify.com

# The storefront custom domain OIDC discovery is served from
# (https://${SHOP_STOREFRONT_DOMAIN}/.well-known/openid-configuration).
# Never hardcode the authorization/token/jwks endpoints this document
# points to -- always discover them fresh.
SHOP_STOREFRONT_DOMAIN=oceansoptics.com

# Secret used to sign/verify this backend's own short-lived session tokens.
# Generate a long random value (e.g. `openssl rand -hex 32`); unrelated to
# any Shopify secret.
SESSION_TOKEN_SECRET=

# Supabase project settings (Project Settings -> API). SUPABASE_SERVICE_ROLE_KEY
# must ONLY ever be set as a Vercel server-side environment variable -- never
# prefixed NEXT_PUBLIC_/VITE_/etc., never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Storefront origin allowed to call the direct (non-proxy) endpoints.
STOREFRONT_ORIGIN=https://oceansoptics.com

# OPTIONAL. Alternative to the SHOPIFY_CLIENT_ID/SHOPIFY_API_SECRET
# client_credentials grant above, for lib/shopify-admin-client.js's learner-
# identity lookup: a static Admin API access token from a separate legacy
# custom app, if that is preferred instead of this app's own credentials.
# NOT the same value as shopify/.env's SHOPIFY_ADMIN_ACCESS_TOKEN (that is a
# different, local-only, content-management app credential with no
# customer-related scope -- see the project report). Requires `read_customers`
# on whichever app issued it. Leave unset unless deliberately using this mode.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# OPTIONAL. Overrides the Admin API version lib/shopify-admin-client.js
# calls for learner-identity lookups. Defaults to the same version as
# [webhooks] api_version in shopify-app/shopify.app.toml if unset.
SHOPIFY_ADMIN_API_VERSION=
