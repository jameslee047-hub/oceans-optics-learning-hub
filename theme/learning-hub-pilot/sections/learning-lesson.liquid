{{ 'learning-hub.css' | asset_url | stylesheet_tag }}
<script src="{{ 'learning-hub-progress-auth.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'learning-hub-media-data.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'learning-hub-inline-media.js' | asset_url }}" defer="defer"></script>
{% comment %}
  Loaded before learning-hub-knowledge-check.js (both use `defer`, so
  execution follows this document order): the "Lesson X of Y" chip this adds
  to .learning-meta must exist before the Take Quiz button is appended, so
  the row reads [Category] [Reading time] [Lesson X of Y] [Take Quiz].
{% endcomment %}
<script src="{{ 'learning-hub-lesson-position-data.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'learning-hub-lesson-position.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'learning-hub-knowledge-check-data.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'learning-hub-knowledge-check.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign lesson_title = metaobject.title.value | default: 'Learning lesson'
  assign short_description = metaobject.short_description.value
  assign lesson_type = metaobject.lesson_type.value
  assign reading_time = metaobject.estimated_reading_time.value
  assign category = metaobject.category.value
  assign key_takeaways = metaobject.key_takeaways.value
  assign related_lessons = metaobject.related_lessons.value
  assign downloadable_resources = metaobject.downloadable_resources.value
  assign hero_media = metaobject.hero_media.value
%}

{% capture utility_nav %}
  <nav class="learning-utility-nav" aria-label="Lesson navigation">
    {% if category != blank %}
      <a class="learning-inline-reference" href="/pages/learn-category/{{ category.system.handle }}">← Back to {{ category.title.value | escape }}</a>
    {% endif %}
    <a class="learning-inline-reference" href="/pages/learn">Learning Hub Home</a>
  </nav>
{% endcapture %}

<article class="learning-hub learning-lesson color-{{ section.settings.color_scheme }} gradient" data-lesson-handle="{{ metaobject.system.handle }}">
  <div class="learning-hub__band learning-lesson-hero">
    <div class="page-width learning-lesson-flow">
      <div class="learning-hero-inner">
        <nav class="learning-breadcrumbs" aria-label="Breadcrumbs">
          <a href="/pages/learn">Learning Hub</a>
          {% if category != blank %}
            <span aria-hidden="true">/</span>
            <a href="/pages/learn-category/{{ category.system.handle }}">{{ category.title.value | escape }}</a>
          {% endif %}
        </nav>

        {{ utility_nav }}

        <header>
          {% if lesson_type != blank %}
            <p class="learning-kicker">
              {{ lesson_type | escape }}
            </p>
          {% endif %}

          <h1>{{ lesson_title | escape }}</h1>

          {% if short_description != blank %}
            <p class="learning-hub__lead">{{ short_description | escape }}</p>
          {% endif %}

          <div class="learning-meta">
            {% if category != blank %}
              <span class="learning-meta__item">{{ category.title.value | escape }}</span>
            {% endif %}
            {% if reading_time != blank %}
              <span class="learning-meta__item">{{ reading_time | escape }}</span>
            {% endif %}
          </div>
        </header>
      </div>
    </div>
  </div>

  {% if hero_media != blank and hero_media.preview_image != blank %}
    <div class="page-width">
      {{ hero_media.preview_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '375, 550, 750, 1100, 1500, 1600', alt: lesson_title }}
    </div>
  {% endif %}

  <div class="learning-hub__band learning-lesson-body-band">
    <div class="page-width learning-lesson-flow">
      {% if metaobject.lesson_body != blank %}
        <div class="learning-article">
          <div class="learning-rich-text">
            {{ metaobject.lesson_body | metafield_tag }}
          </div>
        </div>
      {% endif %}

      {% if downloadable_resources != blank %}
        <section class="learning-panel learning-downloads">
          <p class="learning-hub__eyebrow">Take the Checklist With You</p>
          <h2>Downloads</h2>
          <div class="learning-download-list">
            {% for resource in downloadable_resources %}
              {% if resource.url != blank %}
                <div class="learning-download-card">
                  <span>
                    <strong>{{ resource.alt | default: resource.filename | default: 'Download resource' | escape }}</strong>
                    <small>Printable checklist for planning before you enter the water.</small>
                  </span>
                  <a class="button learning-cta" href="{{ resource.url }}" download>Download Checklist</a>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </section>
      {% endif %}

      {% if key_takeaways != blank or metaobject.instructor_tips != blank or metaobject.common_mistakes != blank or metaobject.safety_notes != blank %}
        <section class="learning-supporting" aria-label="Lesson recap and supporting notes">
          {% if key_takeaways != blank %}
            <section class="learning-panel learning-panel--takeaways">
              <h2>Key Takeaways</h2>
              <ul class="learning-takeaways">
                {% for takeaway in key_takeaways %}
                  <li>{{ takeaway | escape }}</li>
                {% endfor %}
              </ul>
            </section>
          {% endif %}

          {% if metaobject.instructor_tips != blank or metaobject.common_mistakes != blank %}
            <div class="learning-support-grid">
              {% if metaobject.instructor_tips != blank %}
                <section class="learning-panel learning-panel--support">
                  <h2>Instructor Tips</h2>
                  {{ metaobject.instructor_tips | metafield_tag }}
                </section>
              {% endif %}

              {% if metaobject.common_mistakes != blank %}
                <section class="learning-panel learning-panel--support">
                  <h2>Common Mistakes</h2>
                  {{ metaobject.common_mistakes | metafield_tag }}
                </section>
              {% endif %}
            </div>
          {% endif %}

          {% if metaobject.safety_notes != blank %}
            <section class="learning-panel learning-panel--safety">
              <h2>Safety Note</h2>
              {{ metaobject.safety_notes | metafield_tag }}
            </section>
          {% endif %}
        </section>
      {% endif %}

      {% comment %}
        Shell only -- learning-hub-knowledge-check.js fills in the actual
        question/answers from learning-hub-knowledge-check-data.js (keyed by
        this lesson's handle) and removes this section entirely when the
        lesson has no Knowledge Check. Kept out of lesson_body so the correct
        answer is never present in the initial page text.
      {% endcomment %}
      <section class="learning-quiz" id="knowledge-check" data-learning-quiz data-lesson-handle="{{ metaobject.system.handle }}">
        <p class="learning-hub__eyebrow">Knowledge Check</p>
        <h2>Check Your Understanding</h2>
        <form class="learning-quiz__form" data-quiz-form>
          <div class="learning-quiz__card" data-quiz-card>
            <div class="learning-quiz__stage" data-quiz-stage></div>
            <div class="learning-quiz__result" data-quiz-result role="status" aria-live="polite" tabindex="-1" hidden></div>
          </div>
          <div class="learning-hub__actions learning-quiz__actions">
            <button class="button learning-quiz__back" type="button" data-quiz-back hidden>Back</button>
            <button class="button learning-cta" type="button" data-quiz-primary disabled>Check Answer</button>
            <button class="button learning-cta" type="button" data-quiz-retry hidden>Try Again</button>
          </div>
        </form>
      </section>

    </div>
  </div>

  {% if related_lessons != blank %}
    <div class="learning-hub__band learning-hub__band--tinted">
      <div class="page-width">
        <div class="learning-related-lessons">
        <div class="learning-hub__section-heading">
          <div>
            <p class="learning-hub__eyebrow">Next Reads</p>
            <h2>Related Lessons</h2>
          </div>
        </div>

        <div class="learning-related-grid">
          {% for lesson in related_lessons %}
            {% if lesson.system.handle != blank %}
              <a class="learning-related-card" href="/pages/learn/{{ lesson.system.handle }}">
                <h3>{{ lesson.title.value | escape }}</h3>
                {% if lesson.short_description.value != blank %}
                  <p>{{ lesson.short_description.value | escape }}</p>
                {% endif %}
                <span class="learning-card__footer">Read next →</span>
              </a>
            {% else %}
              <div class="learning-related-card learning-related-card--static">
                <h3>{{ lesson.title.value | escape }}</h3>
                {% if lesson.short_description.value != blank %}
                  <p>{{ lesson.short_description.value | escape }}</p>
                {% endif %}
                <span class="learning-card__footer">Planned lesson</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
        </div>
      </div>
    </div>
  {% endif %}

  {% comment %}
    Shell only -- learning-hub-lesson-position.js fills in the actual
    previous/next cards from learning-hub-lesson-position-data.js (keyed by
    this lesson's handle) and removes this section entirely for a lesson
    with neither a previous nor a next public lesson in its category.
  {% endcomment %}
  <div class="learning-hub__band" data-lesson-sequence hidden>
    <div class="page-width learning-lesson-flow"></div>
  </div>

  <div class="learning-hub__band learning-utility-nav-band">
    <div class="page-width">
      {{ utility_nav }}
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Learning lesson",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Learning lesson"
    }
  ]
}
{% endschema %}
