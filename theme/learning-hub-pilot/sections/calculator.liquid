{% comment %}
  Oceans Optics Underwater Lens Calculator — v4 development section.

  DEVELOPMENT ONLY. Not wired into any live or published navigation. Loads
  the canonical calculation logic from assets/lens-calculator-master.js —
  this file must not contain a duplicate copy of the recommendation
  algorithm. See that file's header comment and
  content-development/research/LENS-CALCULATOR-SOURCE-OF-TRUTH.md for the
  methodology this section relies on.

  This section is markup, styling, copy, and UI wiring only.
{% endcomment %}

<style>
  .oo-lens-calc {
    --oo-blue: #023059;
    --oo-orange: #B95E05;
    --oo-white: #FFFFFF;
    font-family: 'Lato', sans-serif;
    max-width: 640px;
    margin: 0 auto;
    padding: 24px 16px 48px;
    color: var(--oo-blue);
  }

  .oo-lens-calc__heading {
    text-align: center;
    color: var(--oo-blue);
    font-family: 'Lato', sans-serif;
    font-weight: 700;
    font-size: 24px;
    margin: 8px auto 4px;
  }

  .oo-lens-calc__intro {
    text-align: center;
    color: var(--oo-blue);
    font-size: 15px;
    max-width: 460px;
    margin: 0 auto 28px;
    opacity: 0.85;
  }

  .oo-lens-calc__eye {
    border: 1px solid rgba(2, 48, 89, 0.15);
    border-radius: 12px;
    padding: 18px 18px 8px;
    margin-bottom: 20px;
    background: #fff;
  }

  .oo-lens-calc__eye-title {
    font-weight: 700;
    font-size: 16px;
    color: var(--oo-blue);
    margin: 0 0 14px;
  }

  .oo-lens-calc__field-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 10px;
  }

  @media (max-width: 640px) {
    .oo-lens-calc__field-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .oo-lens-calc__field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .oo-lens-calc__field-label {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 700;
    color: var(--oo-blue);
  }

  .oo-lens-calc__field input {
    font-family: 'Lato', sans-serif;
    font-size: 15px;
    padding: 8px 10px;
    border: 1px solid rgba(2, 48, 89, 0.35);
    border-radius: 8px;
    color: var(--oo-blue);
    background: #fff;
  }

  .oo-lens-calc__field input:focus {
    outline: 2px solid var(--oo-blue);
    outline-offset: 1px;
  }

  .oo-lens-calc__field input[disabled] {
    background: rgba(2, 48, 89, 0.05);
    color: rgba(2, 48, 89, 0.4);
  }

  .oo-lens-calc__field-optional {
    font-weight: 400;
    font-size: 11px;
    opacity: 0.6;
  }

  /* Tooltip */
  .oo-lens-calc__tooltip {
    position: relative;
    display: inline-flex;
    width: 16px;
    height: 16px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(2, 48, 89, 0.12);
    color: var(--oo-blue);
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    border: none;
  }

  .oo-lens-calc__tooltip .oo-lens-calc__tooltiptext {
    display: none;
    position: absolute;
    z-index: 5;
    bottom: 130%;
    left: 50%;
    transform: translateX(-50%);
    width: 220px;
    background: var(--oo-blue);
    color: var(--oo-white);
    font-weight: 400;
    font-size: 12px;
    line-height: 1.4;
    padding: 10px 12px;
    border-radius: 8px;
  }

  .oo-lens-calc__tooltip.oo-is-open .oo-lens-calc__tooltiptext {
    display: block;
  }

  /* Buttons — hard rule: filled orange/blue buttons keep white text in all states */
  .oo-lens-calc__button {
    font-family: 'Lato', sans-serif;
    font-weight: 700;
    font-size: 16px;
    border: none;
    border-radius: 999px;
    padding: 14px 28px;
    cursor: pointer;
    width: 100%;
    display: block;
    margin: 18px 0 10px;
  }

  .oo-lens-calc__button--primary,
  .oo-lens-calc__button--primary:hover,
  .oo-lens-calc__button--primary:focus,
  .oo-lens-calc__button--primary:active,
  .oo-lens-calc__button--primary:visited {
    background: var(--oo-orange);
    color: var(--oo-white) !important;
  }

  .oo-lens-calc__button--primary:disabled,
  .oo-lens-calc__button--primary:disabled:hover {
    background: rgba(185, 94, 5, 0.5);
    color: var(--oo-white) !important;
    cursor: not-allowed;
  }

  .oo-lens-calc__error {
    display: none;
    background: rgba(185, 94, 5, 0.08);
    border: 1px solid var(--oo-orange);
    color: var(--oo-blue);
    border-radius: 8px;
    padding: 12px 14px;
    font-size: 14px;
    margin: 10px 0;
  }

  .oo-lens-calc__error ul {
    margin: 4px 0 0;
    padding-left: 18px;
  }

  .oo-lens-calc__result {
    display: none;
    background: var(--oo-blue);
    color: var(--oo-white);
    border-radius: 12px;
    padding: 20px;
    margin-top: 20px;
  }

  .oo-lens-calc__result-heading {
    font-weight: 700;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 12px;
    color: var(--oo-white);
  }

  .oo-lens-calc__result-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .oo-lens-calc__result-eye-label {
    font-size: 13px;
    opacity: 0.8;
    margin: 0 0 4px;
  }

  .oo-lens-calc__result-value {
    font-size: 28px;
    font-weight: 700;
    margin: 0;
    color: var(--oo-white);
  }

  .oo-lens-calc__notice {
    display: none;
    background: rgba(2, 48, 89, 0.06);
    border-left: 3px solid var(--oo-blue);
    color: var(--oo-blue);
    padding: 10px 14px;
    font-size: 13px;
    border-radius: 6px;
    margin-top: 16px;
  }

  .oo-lens-calc__disclaimer {
    font-size: 12px;
    opacity: 0.7;
    margin-top: 20px;
    text-align: center;
  }

  .oo-lens-calc__dev-banner {
    background: var(--oo-orange);
    color: var(--oo-white);
    text-align: center;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 12px;
    border-radius: 8px;
    margin-bottom: 20px;
  }
</style>

<div class="oo-lens-calc" id="oo-lens-calc-root">
  <div class="oo-lens-calc__dev-banner">Development preview — not the live Lens Calculator.</div>

  <h1 class="oo-lens-calc__heading">Underwater Lens Calculator</h1>
  <p class="oo-lens-calc__intro">Enter your prescription exactly as it appears on your eye prescription. You do not need to convert anything yourself.</p>

  <form id="oo-lens-calc-form">
    {% for side in (1..2) %}
      {% assign eye_key = 'right' %}
      {% assign eye_label = 'Right Eye (OD)' %}
      {% if side == 2 %}
        {% assign eye_key = 'left' %}
        {% assign eye_label = 'Left Eye (OS)' %}
      {% endif %}

      <div class="oo-lens-calc__eye">
        <p class="oo-lens-calc__eye-title">{{ eye_label }}</p>
        <div class="oo-lens-calc__field-row">

          <div class="oo-lens-calc__field">
            <label class="oo-lens-calc__field-label" for="oo-{{ eye_key }}-sphere">
              SPH
              <button type="button" class="oo-lens-calc__tooltip" data-oo-tooltip>
                ?
                <span class="oo-lens-calc__tooltiptext">The main spherical correction. Minus values usually indicate nearsightedness; plus values usually indicate farsightedness.</span>
              </button>
            </label>
            <input type="text" inputmode="decimal" id="oo-{{ eye_key }}-sphere" data-oo-field="sphere" data-oo-eye="{{ eye_key }}" placeholder="e.g. -3.00" autocomplete="off">
          </div>

          <div class="oo-lens-calc__field">
            <label class="oo-lens-calc__field-label" for="oo-{{ eye_key }}-cylinder">
              CYL
              <button type="button" class="oo-lens-calc__tooltip" data-oo-tooltip>
                ?
                <span class="oo-lens-calc__tooltiptext">Astigmatism correction. Enter the value and sign exactly as written on your prescription. Enter 0.00 if you don't have a CYL value.</span>
              </button>
            </label>
            <input type="text" inputmode="decimal" id="oo-{{ eye_key }}-cylinder" data-oo-field="cylinder" data-oo-eye="{{ eye_key }}" placeholder="e.g. -1.50 or 0.00" autocomplete="off">
          </div>

          <div class="oo-lens-calc__field">
            <label class="oo-lens-calc__field-label" for="oo-{{ eye_key }}-axis">
              AXIS
              <button type="button" class="oo-lens-calc__tooltip" data-oo-tooltip>
                ?
                <span class="oo-lens-calc__tooltiptext">The orientation of your astigmatism correction, from 1 to 180. Enter it exactly as written. Not needed if your CYL is 0.00.</span>
              </button>
            </label>
            <input type="text" inputmode="numeric" id="oo-{{ eye_key }}-axis" data-oo-field="axis" data-oo-eye="{{ eye_key }}" placeholder="1–180" autocomplete="off">
          </div>

          <div class="oo-lens-calc__field">
            <label class="oo-lens-calc__field-label" for="oo-{{ eye_key }}-add">
              ADD <span class="oo-lens-calc__field-optional">optional</span>
              <button type="button" class="oo-lens-calc__tooltip" data-oo-tooltip>
                ?
                <span class="oo-lens-calc__tooltiptext">Additional near-vision power found on some prescriptions. Optional.</span>
              </button>
            </label>
            <input type="text" inputmode="decimal" id="oo-{{ eye_key }}-add" data-oo-field="add" data-oo-eye="{{ eye_key }}" placeholder="optional" autocomplete="off">
          </div>

        </div>
      </div>
    {% endfor %}

    <div class="oo-lens-calc__error" id="oo-lens-calc-error" role="alert"></div>

    <button type="submit" class="oo-lens-calc__button oo-lens-calc__button--primary" id="oo-lens-calc-submit">Find My Lens Strength</button>
  </form>

  <div class="oo-lens-calc__result" id="oo-lens-calc-result">
    <p class="oo-lens-calc__result-heading">Your Recommended Lens Strength</p>
    <div class="oo-lens-calc__result-grid">
      <div>
        <p class="oo-lens-calc__result-eye-label">Right</p>
        <p class="oo-lens-calc__result-value" id="oo-lens-calc-result-right">—</p>
      </div>
      <div>
        <p class="oo-lens-calc__result-eye-label">Left</p>
        <p class="oo-lens-calc__result-value" id="oo-lens-calc-result-left">—</p>
      </div>
    </div>
  </div>

  <div class="oo-lens-calc__notice" id="oo-lens-calc-add-notice">
    Your prescription includes an ADD value. This standard lens recommendation is based on your distance prescription and does not incorporate near/additional power.
  </div>

  <p class="oo-lens-calc__disclaimer">This calculator is a decision-support tool, not a substitute for a professional eye exam. If you're unsure about your prescription, check with your optometrist.</p>
</div>

<script src="{{ 'lens-calculator-master.js' | asset_url }}" defer></script>
<script defer>
  document.addEventListener('DOMContentLoaded', function () {
    var root = document.getElementById('oo-lens-calc-root');
    if (!root) return;

    var LC = window.OOLensCalculator;
    if (!LC) {
      console.error('OOLensCalculator failed to load; calculator cannot run.');
      return;
    }

    var form = document.getElementById('oo-lens-calc-form');
    var errorBox = document.getElementById('oo-lens-calc-error');
    var resultBox = document.getElementById('oo-lens-calc-result');
    var resultRight = document.getElementById('oo-lens-calc-result-right');
    var resultLeft = document.getElementById('oo-lens-calc-result-left');
    var addNotice = document.getElementById('oo-lens-calc-add-notice');

    function fieldValue(eye, field) {
      var el = root.querySelector('[data-oo-eye="' + eye + '"][data-oo-field="' + field + '"]');
      return el ? el.value : '';
    }

    function axisInput(eye) {
      return root.querySelector('[data-oo-eye="' + eye + '"][data-oo-field="axis"]');
    }

    function cylinderInput(eye) {
      return root.querySelector('[data-oo-eye="' + eye + '"][data-oo-field="cylinder"]');
    }

    // Disable AXIS automatically when CYL is 0.00 (or blank), per the input
    // design — AXIS is not needed and should not affect the calculation.
    function syncAxisAvailability(eye) {
      var cylEl = cylinderInput(eye);
      var axisEl = axisInput(eye);
      if (!cylEl || !axisEl) return;
      var raw = cylEl.value.trim();
      var isZeroOrBlank = raw === '' || parseFloat(raw) === 0;
      axisEl.disabled = isZeroOrBlank;
      if (isZeroOrBlank) axisEl.value = '';
    }

    ['right', 'left'].forEach(function (eye) {
      var cylEl = cylinderInput(eye);
      if (cylEl) {
        cylEl.addEventListener('input', function () { syncAxisAvailability(eye); });
        syncAxisAvailability(eye);
      }
    });

    // Tooltip open/close.
    root.querySelectorAll('[data-oo-tooltip]').forEach(function (tip) {
      tip.addEventListener('click', function (e) {
        e.preventDefault();
        var wasOpen = tip.classList.contains('oo-is-open');
        root.querySelectorAll('[data-oo-tooltip]').forEach(function (t) { t.classList.remove('oo-is-open'); });
        if (!wasOpen) tip.classList.add('oo-is-open');
      });
    });
    document.addEventListener('click', function (e) {
      if (!e.target.closest('[data-oo-tooltip]')) {
        root.querySelectorAll('[data-oo-tooltip]').forEach(function (t) { t.classList.remove('oo-is-open'); });
      }
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      var rightInput = {
        sphere: fieldValue('right', 'sphere'),
        cylinder: fieldValue('right', 'cylinder'),
        axis: fieldValue('right', 'axis'),
        add: fieldValue('right', 'add')
      };
      var leftInput = {
        sphere: fieldValue('left', 'sphere'),
        cylinder: fieldValue('left', 'cylinder'),
        axis: fieldValue('left', 'axis'),
        add: fieldValue('left', 'add')
      };

      var pair = LC.calculatePrescriptionPair(rightInput, leftInput);

      if (!pair.valid) {
        errorBox.innerHTML = '<strong>Please check your prescription entries:</strong><ul>' +
          pair.errors.map(function (msg) { return '<li>' + msg + '</li>'; }).join('') +
          '</ul>';
        errorBox.style.display = 'block';
        resultBox.style.display = 'none';
        addNotice.style.display = 'none';
        return;
      }

      errorBox.style.display = 'none';
      resultRight.textContent = pair.right.recommendation;
      resultLeft.textContent = pair.left.recommendation;
      resultBox.style.display = 'block';
      addNotice.style.display = (pair.right.addNotice || pair.left.addNotice) ? 'block' : 'none';
    });
  });
</script>

{% schema %}
{
  "name": "Lens Calculator v4 (dev)",
  "settings": [],
  "presets": [
    {
      "name": "Underwater Lens Calculator (v4 dev)"
    }
  ]
}
{% endschema %}
