<script>

  (function() {

    var section =
      document.getElementById(
        'oo-learning-hero-{{ section.id }}'
      );


    if (!section) return;


    var shell =
      section.querySelector(
        '[data-oo-learning-shell]'
      );


    var content =
      section.querySelector(
        '[data-oo-learning-content]'
      );


    var inner =
      section.querySelector(
        '.oo-learning-hero__inner'
      );


    if (
      !shell ||
      !content ||
      !inner
    ) {
      return;
    }


    var desktopQuery =
      window.matchMedia(
        '(min-width: 990px)'
      );


    function resetMobile() {

      shell.style.height = '';

      content.style.position = '';
      content.style.top = '';
      content.style.left = '';
      content.style.width = '';
      content.style.transform = '';

    }


    function fitDesktopContent() {

      /*
        Mobile is natural-height.
        Never scale mobile typography.
      */

      if (!desktopQuery.matches) {

        resetMobile();

        return;
      }


      /*
        Reset before measuring.
      */

      content.style.position = 'relative';

      content.style.top = '';
      content.style.left = '';

      content.style.width = '100%';

      content.style.transform = 'none';

      shell.style.height = 'auto';


      var innerStyles =
        window.getComputedStyle(inner);


      var availableHeight =
        inner.clientHeight
        -
        parseFloat(
          innerStyles.paddingTop || 0
        )
        -
        parseFloat(
          innerStyles.paddingBottom || 0
        );


      var naturalHeight =
        content.scrollHeight;


      if (
        !naturalHeight ||
        !availableHeight
      ) {
        return;
      }


      /*
        If content is taller than the hero,
        shrink the ENTIRE content group proportionally.

        Nothing gets clipped.
      */

      var scale =
        Math.min(
          1,
          availableHeight / naturalHeight
        );


      content.style.position = 'absolute';

      content.style.top = '0';
      content.style.left = '0';

      content.style.width = '100%';

      content.style.transform =
        'scale(' + scale + ')';


      /*
        Shell takes the scaled visual height,
        allowing Flexbox to centre it vertically.
      */

      shell.style.height =
        Math.ceil(
          naturalHeight * scale
        ) + 'px';

    }


    var resizeTimer;


    function queueFit() {

      window.clearTimeout(
        resizeTimer
      );


      resizeTimer =
        window.setTimeout(
          fitDesktopContent,
          40
        );

    }


    /*
      Initial layout.
    */

    requestAnimationFrame(
      function() {

        requestAnimationFrame(
          fitDesktopContent
        );

      }
    );


    /*
      Refit after fonts load.
    */

    if (
      document.fonts &&
      document.fonts.ready
    ) {

      document.fonts.ready.then(
        fitDesktopContent
      );

    }


    /*
      Browser resizing.
    */

    window.addEventListener(
      'resize',
      queueFit
    );


    window.addEventListener(
      'orientationchange',
      queueFit
    );


    /*
      Shopify Theme Editor.
    */

    document.addEventListener(
      'shopify:section:load',
      queueFit
    );


    document.addEventListener(
      'shopify:block:select',
      queueFit
    );


    document.addEventListener(
      'shopify:block:deselect',
      queueFit
    );

  })();

</script>


