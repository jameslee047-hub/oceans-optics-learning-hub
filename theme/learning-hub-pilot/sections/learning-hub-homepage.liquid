{{ 'learning-hub.css' | asset_url | stylesheet_tag }}
<script src="{{ 'learning-hub-progress-auth.js' | asset_url }}" defer="defer"></script>
{% render 'learning-hub-theme-state' %}
<script src="{{ 'learning-hub-progress-tracking.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign step_blocks = section.blocks | where: 'type', 'pathway_step'
  assign category_blocks = section.blocks | where: 'type', 'category'
  assign lesson_blocks = section.blocks | where: 'type', 'lesson'
%}

<section class="learning-hub color-{{ section.settings.color_scheme }} gradient">
  <div class="learning-hub__band">
    <div class="page-width learning-hub__intro">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="learning-hub__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        <h1>{{ section.settings.heading | escape }}</h1>

        {% if section.settings.intro != blank %}
          <p class="learning-hub__lead">{{ section.settings.intro | escape }}</p>
        {% endif %}

        <div class="learning-hub__actions">
          {% if section.settings.primary_link_label != blank %}
            <a class="button learning-cta" href="{{ section.settings.primary_link | default: '#learning-hub-start-here' }}">
              {{ section.settings.primary_link_label | escape }}
            </a>
          {% endif %}

          {% if section.settings.secondary_link_label != blank %}
            <a class="button learning-cta" href="{{ section.settings.secondary_link | default: '#learning-hub-categories' }}">
              {{ section.settings.secondary_link_label | escape }}
            </a>
          {% endif %}
        </div>

        <p class="learning-hub__secondary-nav">
          <a class="learning-inline-reference" href="/pages/my-learning">View My Learning Progress &rarr;</a>
        </p>
      </div>
    </div>
  </div>

  {% if step_blocks.size > 0 %}
    <div id="learning-hub-start-here" class="learning-hub__band learning-hub__band--tinted">
      <div class="page-width">
        <div class="learning-hub__section-heading">
          <div>
            <p class="learning-hub__eyebrow">Start Here</p>
            <h2>{{ section.settings.start_heading | escape }}</h2>
          </div>
          {% if section.settings.start_intro != blank %}
            <p>{{ section.settings.start_intro | escape }}</p>
          {% endif %}
        </div>

        <div class="learning-sequence-grid">
          {% for block in step_blocks %}
            {% if block.settings.url != blank %}
              <a class="learning-sequence-card" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
            {% else %}
              <div class="learning-sequence-card" {{ block.shopify_attributes }}>
            {% endif %}
                <span class="learning-sequence-card__number">{{ forloop.index }}</span>
                <span class="learning-sequence-card__title">{{ block.settings.title | escape }}</span>
                {% if block.settings.description != blank %}
                  <span class="learning-sequence-card__subtitle">{{ block.settings.description | escape }}</span>
                {% endif %}
            {% if block.settings.url != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  {% if category_blocks.size > 0 %}
    <div id="learning-hub-categories" class="learning-hub__band">
      <div class="page-width">
        <div class="learning-hub__section-heading">
          <div>
            <p class="learning-hub__eyebrow">Browse By Subject</p>
            <h2>{{ section.settings.category_heading | escape }}</h2>
          </div>
          {% if section.settings.category_intro != blank %}
            <p>{{ section.settings.category_intro | escape }}</p>
          {% endif %}
        </div>

        <div class="learning-grid">
          {% for block in category_blocks %}
            {% if block.settings.url != blank %}
              <a class="learning-card" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
            {% else %}
              <div class="learning-card" {{ block.shopify_attributes }}>
            {% endif %}
                <span class="learning-card__meta">{{ block.settings.label | escape }}</span>
                <h3>{{ block.settings.title | escape }}</h3>
                {% if block.settings.description != blank %}
                  <p>{{ block.settings.description | escape }}</p>
                {% endif %}
                {% if block.settings.url != blank %}
                  <span class="learning-card__footer">View category</span>
                {% endif %}
            {% if block.settings.url != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  {% if lesson_blocks.size > 0 %}
    <div id="learning-hub-pilots" class="learning-hub__band learning-hub__band--tinted">
      <div class="page-width">
        <div class="learning-hub__section-heading">
          <div>
            <p class="learning-hub__eyebrow">Featured Learning</p>
            <h2>{{ section.settings.lesson_heading | escape }}</h2>
          </div>
          {% if section.settings.lesson_intro != blank %}
            <p>{{ section.settings.lesson_intro | escape }}</p>
          {% endif %}
        </div>

        <div class="learning-grid learning-grid--two">
          {% for block in lesson_blocks %}
            {% if block.settings.url != blank %}
              <a class="learning-card" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
            {% else %}
              <div class="learning-card" {{ block.shopify_attributes }}>
            {% endif %}
                <span class="learning-card__meta">
                  {% if block.settings.lesson_type != blank %}
                    {{ block.settings.lesson_type | escape }}
                  {% endif %}
                </span>
                <h3>{{ block.settings.title | escape }}</h3>
                {% if block.settings.description != blank %}
                  <p>{{ block.settings.description | escape }}</p>
                {% endif %}
                {% if block.settings.url != blank %}
                  <span class="learning-card__footer">Open lesson</span>
                {% endif %}
            {% if block.settings.url != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}
</section>

