          <table class="range-mini"><thead><tr><th></th><th>Min</th><th>Max</th><th>You</th></tr></thead><tbody>
            <tr><td><strong>Eye Width</strong></td><td>${f(m.wMin)}</td><td>${f(m.wMax)}</td><td class="${cls(wIn,m.wMin,m.wMax)}">${f(wIn)}</td></tr>
            <tr><td><strong>Mask Height</strong></td><td>${f(m.hMin)}</td><td>${f(m.hMax)}</td><td class="${cls(hIn,m.hMin,m.hMax)}">${f(hIn)}</td></tr>
            <tr><td><strong>Head Circ.</strong></td><td>${f(m.headMin)}</td><td>${f(m.headMax)}</td><td class="${cls(headIn,m.headMin,m.headMax)}">${f(headIn)}</td></tr>
          </tbody></table>
          <div class="mask-specs">
            <span><span class="spec-label">Skirt:</span> ${skirtBadges}</span>
            <span><span class="spec-label">Frame:</span> ${frameBadges}</span>
            <span><span class="spec-label">Diopters:</span> ${m.diopters}</span>
          </div>
          <div class="cta-row"><a href="${m.link}" target="_blank" rel="noopener" class="btn-product">${isBest?'View Best Fit Mask':(s<=GOOD_THRESHOLD&&allInRange)?'View Good Fit Mask':'View This Mask'}</a></div>
        </div>`;
      gridEl.appendChild(card);
    });
  }

  function renderAskPro(best){
    if(!best){askWrap.innerHTML='';return;}
    askWrap.innerHTML=`<div class="ask-pro-bar"><span class="label">Not sure? Our team can confirm your fit — just send your measurements and an optional face photo.</span><button class="btn-outline" id="askProBtn">Ask a Pro</button></div>`;
    $('#askProBtn').addEventListener('click',()=>{
      const fm=v=>v!=null?`${v.toFixed(2)} in / ${(v*IN2CM).toFixed(1)} cm`:'not entered';
      const noseLabel=noseSize?noseSize.charAt(0).toUpperCase()+noseSize.slice(1):'not selected';
      const subject=encodeURIComponent('Mask sizing check - can you confirm fit?');
      const body=encodeURIComponent(`Hi Oceans Optics team,\n\nCould you help confirm which mask will fit me?\n\nMy measurements:\n- Eye width: ${fm(wIn)}\n- Mask height: ${fm(hIn)}\n- Head circumference: ${fm(headIn)}\n- Nose size: ${noseLabel}\n\nThe tool suggested: ${best.name}\n\nI can attach a front-on face photo if that helps.\n\nThanks`);
      window.open(`mailto:${ASK_EMAIL}?subject=${subject}&body=${body}`,'_blank','noopener,noreferrer');
    });
  }

  function clearResults(){
    msgEl.innerHTML='';askWrap.innerHTML='';
    const headingEl=document.getElementById('resultsHeading');if(headingEl)headingEl.textContent='Your Mask Recommendations';
    subEl.textContent='Enter your measurements and we will find the best masks for you.';
    gridEl.innerHTML=`<div class="empty-results"><div class="icon">\uD83D\uDCD0</div><p>Move the sliders to see all masks ranked for your measurements.</p></div>`;
  }

  configSliders();clearResults();

  // Camera button: new tab on desktop (≥769px), same tab on mobile
  const camBtn=document.getElementById('oo-camera-btn');
  if(camBtn){
    if(window.innerWidth>=769){camBtn.setAttribute('target','_blank');camBtn.setAttribute('rel','noopener noreferrer');}
    else{camBtn.removeAttribute('target');camBtn.removeAttribute('rel');}
  }
})();
</script>

