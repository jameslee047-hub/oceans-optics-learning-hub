{% liquid
assign quiz_source = 'site_section'
assign quiz_page_type = request.page_type
assign quiz_page_handle = 'unknown'

if request.page_type == 'index'
assign quiz_source = 'home_page'
assign quiz_page_type = 'home'
assign quiz_page_handle = 'home'
elsif article
assign quiz_source = 'blog_article'
assign quiz_page_type = 'article'
assign quiz_page_handle = article.handle
elsif collection
assign quiz_source = 'collection_page'
assign quiz_page_type = 'collection'
assign quiz_page_handle = collection.handle
elsif product
assign quiz_source = 'product_page'
assign quiz_page_type = 'product'
assign quiz_page_handle = product.handle
elsif page
assign quiz_source = 'page'
assign quiz_page_type = 'page'
assign quiz_page_handle = page.handle
endif

assign quiz_source_encoded = quiz_source | url_encode
assign quiz_page_type_encoded = quiz_page_type | url_encode
assign quiz_page_handle_encoded = quiz_page_handle | url_encode

assign quiz_url = 'https://quiz.oceansoptics.com/quiz?start=1'
assign quiz_url = quiz_url | append: '&utm_source=' | append: quiz_source_encoded
assign quiz_url = quiz_url | append: '&utm_medium=section_cta'
assign quiz_url = quiz_url | append: '&utm_campaign=rx_mask_finder'
assign quiz_url = quiz_url | append: '&quiz_source=' | append: quiz_source_encoded
assign quiz_url = quiz_url | append: '&quiz_page_type=' | append: quiz_page_type_encoded
assign quiz_url = quiz_url | append: '&quiz_page_handle=' | append: quiz_page_handle_encoded
assign quiz_url = quiz_url | append: '&quiz_placement=section_cta'

assign judgeme_rating_raw = shop.metafields.judgeme.all_reviews_rating.value | default: shop.metafields.judgeme.all_reviews_rating
assign judgeme_count_raw = shop.metafields.judgeme.all_reviews_count.value | default: shop.metafields.judgeme.all_reviews_count

if judgeme_rating_raw != blank and judgeme_count_raw != blank
assign judgeme_rating_display = judgeme_rating_raw | times: 1.0 | round: 2
assign review_label = judgeme_rating_display | append: ' / 5 based on ' | append: judgeme_count_raw | append: ' verified reviews'
else
assign review_label = section.settings.review_text
endif
%}

<style>
  .oo-quiz-card-section,
  .oo-quiz-card-section * {
    box-sizing: border-box;
  }

  .oo-quiz-card-section {
    background: #f0f4f8;
    padding: 64px 16px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
  }

  .oo-quiz-card-card {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 48px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    box-shadow: 0 4px 24px rgba(2, 48, 89, 0.08);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .oo-quiz-card-eyebrow {
    margin: 0 0 12px;
    font-size: 13px;
    line-height: 1.3;
    font-weight: 700;
    color: #B95E05;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .oo-quiz-card-heading {
    margin: 0;
    color: #023059;
    font-size: 32px;
    line-height: 1.15;
    font-weight: 900;
    letter-spacing: 0;
  }

  .oo-quiz-card-body {
    margin: 12px 0 0;
    color: #4b5563;
    font-size: 16px;
    line-height: 1.6;
    max-width: 600px;
  }

  .oo-quiz-card-time {
    margin: 8px 0 0;
    color: #6b7280;
    font-size: 14px;
    line-height: 1.45;
  }

  .oo-quiz-card-button {
    display: block;
    width: 100%;
    max-width: 460px;
    margin: 24px auto 0;
    padding: 14px 32px;
    border-radius: 999px;
    background: #B95E05;
    color: #ffffff !important;
    font-size: 18px;
    line-height: 1.2;
    font-weight: 800;
    text-align: center;
    text-decoration: none !important;
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .oo-quiz-card-button:hover {
    opacity: 0.9;
    color: #ffffff !important;
    text-decoration: none !important;
  }

  .oo-quiz-card-button:active {
    transform: scale(0.95);
  }

  .oo-quiz-card-prep {
    margin: 16px 0 0;
    color: #6b7280;
    font-size: 14px;
    line-height: 1.45;
    max-width: 560px;
  }

  .oo-quiz-card-badges {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  .oo-quiz-card-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    padding: 6px 14px;
    color: #374151;
    font-size: 13px;
    line-height: 1.2;
    font-weight: 600;
    white-space: nowrap;
  }

  .oo-quiz-card-badge-icon {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    display: block;
  }

  .oo-quiz-card-review {
    margin-top: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    color: #023059;
  }

  .oo-quiz-card-stars {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
  }

  .oo-quiz-card-star {
    width: 18px;
    height: 18px;
    display: block;
    fill: #B95E05;
  }

  .oo-quiz-card-review-text {
    margin-left: 4px;
    color: #023059;
    font-size: 13px;
    line-height: 1.35;
    font-weight: 600;
  }

  .oo-quiz-card-privacy {
    margin: 16px 0 0;
    color: #9ca3af;
    font-size: 12px;
    line-height: 1.4;
  }

  @media (max-width: 749px) {
    .oo-quiz-card-section {
      padding: 40px 16px;
    }

    .oo-quiz-card-card {
      padding: 28px;
    }

    .oo-quiz-card-heading {
      font-size: 26px;
    }
  }

  @media (max-width: 480px) {
    .oo-quiz-card-section {
      padding: 28px 12px;
    }

    .oo-quiz-card-card {
      padding: 24px 18px;
      border-radius: 18px;
    }

    .oo-quiz-card-eyebrow {
      font-size: 12px;
      margin-bottom: 10px;
    }

    .oo-quiz-card-heading {
      font-size: 24px;
    }

    .oo-quiz-card-body {
      font-size: 15px;
      line-height: 1.5;
    }

    .oo-quiz-card-button {
      margin-top: 22px;
      padding: 13px 24px;
      font-size: 17px;
    }

    .oo-quiz-card-badges {
      gap: 7px;
    }

    .oo-quiz-card-review {
      flex-direction: column;
      gap: 3px;
    }

    .oo-quiz-card-review-text {
      margin-left: 0;
    }
  }
</style>

<section class="oo-quiz-card-section">
  <div class="oo-quiz-card-card">
    <p class="oo-quiz-card-eyebrow">
      {{ section.settings.eyebrow | escape }}
    </p>

    <h2 class="oo-quiz-card-heading">
      {{ section.settings.heading | escape }}
    </h2>

    <p class="oo-quiz-card-body">
      {{ section.settings.body_text | escape }}
    </p>

    <p class="oo-quiz-card-time">
      {{ section.settings.time_text | escape }}
    </p>

    <a
      class="oo-quiz-card-button"
      href="{{ quiz_url | escape }}"
    >
      {{ section.settings.button_text | escape }}
    </a>

    <p class="oo-quiz-card-prep">
      {{ section.settings.prep_text | escape }}
    </p>

    <div class="oo-quiz-card-badges" aria-label="Quiz benefits">
      <span class="oo-quiz-card-badge">
        <svg class="oo-quiz-card-badge-icon" viewBox="0 0 24 24" fill="none" stroke="#B95E05" stroke-width="2" aria-hidden="true">
          <circle cx="7" cy="12" r="4"></circle>
          <circle cx="17" cy="12" r="4"></circle>
          <path d="M11 12h2M1 12h2M21 12h2"></path>
        </svg>
        {{ section.settings.badge_1_text | escape }}
      </span>

      <span class="oo-quiz-card-badge">
        <svg class="oo-quiz-card-badge-icon" viewBox="0 0 24 24" fill="none" stroke="#B95E05" stroke-width="2" aria-hidden="true">
          <path d="M12 3C8 3 5 7 5 11c0 6 3 10 7 10s7-4 7-10c0-4-3-8-7-8z"></path>
          <path d="M9 14c1 1 5 1 6 0"></path>
        </svg>
        {{ section.settings.badge_2_text | escape }}
      </span>

      <span class="oo-quiz-card-badge">
        <svg class="oo-quiz-card-badge-icon" viewBox="0 0 24 24" fill="none" stroke="#B95E05" stroke-width="2" aria-hidden="true">
          <path d="M2 10c2 0 2-3 4-3s2 3 4 3 2-3 4-3 2 3 4 3"></path>
          <path d="M2 16c2 0 2-3 4-3s2 3 4 3 2-3 4-3 2 3 4 3"></path>
        </svg>
        {{ section.settings.badge_3_text | escape }}
      </span>
    </div>

    {% if section.settings.show_reviews %}
      <div class="oo-quiz-card-review" aria-label="{{ review_label | escape }}">
        <span class="oo-quiz-card-stars" aria-hidden="true">
          <svg class="oo-quiz-card-star" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
          <svg class="oo-quiz-card-star" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
          <svg class="oo-quiz-card-star" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
          <svg class="oo-quiz-card-star" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
          <svg class="oo-quiz-card-star" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
        </span>

        <span class="oo-quiz-card-review-text">
          {{ review_label | escape }}
        </span>
      </div>
    {% endif %}

    {% if section.settings.show_privacy %}
      <p class="oo-quiz-card-privacy">
        {{ section.settings.privacy_text | escape }}
      </p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "OO Quiz Card",
  "tag": "section",
  "class": "section-oo-quiz-card",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Rx Lens Strength + Face Fit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Prescription Mask Quiz"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Built specifically for prescription snorkel and dive masks, this quiz helps match your lens strength, face fit, and intended use in one simple flow."
    },
    {
      "type": "text",
      "id": "time_text",
      "label": "Time text",
      "default": "Answer up to 6 quick questions in about 2 minutes."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Start the quiz →"
    },
    {
      "type": "textarea",
      "id": "prep_text",
      "label": "Prep text",
      "default": "Have your prescription nearby if you know your numbers. If not, no problem, we can still guide you."
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 text",
      "default": "Lens strength"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 text",
      "default": "Face fit"
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Badge 3 text",
      "default": "Snorkel or dive"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show review row",
      "default": true
    },
    {
      "type": "text",
      "id": "review_text",
      "label": "Fallback review text",
      "default": "4.94 / 5 based on 1,220 verified reviews"
    },
    {
      "type": "checkbox",
      "id": "show_privacy",
      "label": "Show privacy line",
      "default": true
    },
    {
      "type": "text",
      "id": "privacy_text",
      "label": "Privacy text",
      "default": "Your prescription image is only used to read your values. It is never stored."
    }
  ],
  "presets": [
    {
      "name": "OO Quiz Card"
    }
  ]
}
{% endschema %}