function snapToHalf(valueAbs, bias) {
  const x = Math.max(0, Number(valueAbs || 0));
  const down = Math.floor(x * 2 + 1e-9) / 2;
  const up = Math.ceil(x * 2 - 1e-9) / 2;
  if (Math.abs(x - down) < 1e-9) return down;
  if (bias === "weaker") return down;
  if (bias === "stronger") return up;
  return Math.abs(x-down) <= Math.abs(up-x) ? down : up;
}

function calcOne(sphere, sign, side) {
  const cylRange = document.getElementById(`cyl-range-${side}`)?.value || "none";
  const cylSignBtn = document.getElementById(`cyl-sign-${side}`);
  const cylSign = cylSignBtn ? cylSignBtn.innerText : "+/-";
  const isCylMinus = cylSign === "-";
  const val = Math.max(0, Number(sphere || 0));
  const isFar = sign === "+";

  if (isFar) {
    if (Math.abs(val - 0.50) < 1e-6 || Math.abs(val - 0.75) < 1e-6) {
      if (!isCylMinus && cylRange !== "none") return "+1.00";
      return "0.00";
    }
    let result;
    if (cylRange === "none" || cylRange === "low") {
      result = Math.floor(val + 1e-9);
      if (result === 0) result = 1;
    } else if (cylRange === "medium") {
      result = isCylMinus ? Math.floor(val + 1e-9) : Math.ceil(val - 1e-9);
    } else if (cylRange === "high") {
      result = Math.round(val);
    } else {
      result = isCylMinus ? Math.round(Math.max(0, val - 0.75)) : Math.round(val + 0.75);
    }
    if (result > 5.00) result = 5.00;
    if (result > 0 && result < 1.00) result = 1.00;
    if (result === 0) return "0.00";
    return `+${result.toFixed(2)}`;
  }

  const whole = Math.floor(val + 1e-9);
  const frac = Math.round((val - whole) * 100) / 100;
  let targetAbs = val, bias = "nearest";

  if (cylRange === "none" || cylRange === "low") {
    const reduce = (Math.abs(frac-0.25)<1e-6 || Math.abs(frac-0.75)<1e-6) ? 0.25 : 0.50;
    targetAbs = Math.max(0, val - reduce); bias = "weaker";
  } else if (cylRange === "medium") {
    if (isCylMinus) { targetAbs = val; bias = "nearest"; }
    else { targetAbs = Math.max(0, val - 0.50); bias = "weaker"; }
  } else if (cylRange === "high") {
    if (isCylMinus) { targetAbs = val; bias = "stronger"; }
    else { targetAbs = val; bias = "weaker"; }
  } else {
    if (isCylMinus) { targetAbs = val + 0.75; bias = "nearest"; }
    else { targetAbs = Math.max(0, val - 0.75); bias = "nearest"; }
  }

  if ((cylRange === "high" || cylRange === "very-high") && val <= 0.75 && val > 0) return "-1.00";

  let recAbs = snapToHalf(targetAbs, bias);
  if (recAbs > 9.00) recAbs = 9.00;
  if (recAbs > 0 && recAbs < 1.00) recAbs = 1.00;
  return recAbs === 0 ? "0.00" : `-${recAbs.toFixed(2)}`;
}

function calculateLensStrength() {
  const leftSphere = parseFloat(document.getElementById("leftEyeSphere").value) || 0;
  const rightSphere = parseFloat(document.getElementById("rightEyeSphere").value) || 0;
  const leftSign = document.getElementById("leftEyeSphereSign").innerText;
  const rightSign = document.getElementById("rightEyeSphereSign").innerText;
  const leftCylRange = document.getElementById("cyl-range-left").value;
  const rightCylRange = document.getElementById("cyl-range-right").value;
  const leftCylSign = document.getElementById("cyl-sign-left").innerText;
  const rightCylSign = document.getElementById("cyl-sign-right").innerText;
  const msg = document.getElementById("error-message");

  if (leftSign === "+/-" || rightSign === "+/-") {
    msg.textContent = "Error: Choose + or − for both eyes.";
    msg.style.display = "block";
    ["#leftEyeSphereSign","#rightEyeSphereSign"].forEach(sel => {
      const el = document.querySelector(sel);
      el.style.animation = "none";
      setTimeout(() => el.style.animation = "bounce 1s", 50);
    });
    return;
  }
  if ((leftCylSign === "+/-" && leftCylRange !== "none") || (rightCylSign === "+/-" && rightCylRange !== "none")) {
    msg.textContent = "Please select + or − for your CYL values, or select 0.00 if you have no cylinder.";
    msg.style.display = "block";
    return;
  }
  msg.style.display = "none";

  const adjLeft = calcOne(leftSphere, leftSign, "left");
  const adjRight = calcOne(rightSphere, rightSign, "right");

  calculatedLeft = adjLeft;
  calculatedRight = adjRight;

  displayResults(adjRight, "recommendedRight");
  displayResults(adjLeft, "recommendedLeft");
  document.getElementById("result-summary").style.display = "block";

  const grid = document.getElementById("maskGrid");
  grid.innerHTML = "";

  if (leftSign !== rightSign) {
    grid.innerHTML = '<h1 class="recomment-headline">We currently do not have masks that support different lens types (nearsighted + farsighted) for each eye. Please contact us for custom solutions.</h1>';
    return;
  }

  if (adjLeft === "0.00" && adjRight === "0.00") {
    const successHeader = createSuccessHeader(adjLeft, adjRight, maskData.length);
    grid.appendChild(successHeader);
    renderCards(maskData, grid);
    setTimeout(() => document.querySelector(".calculator-recommendations").scrollIntoView({ behavior: "smooth", block: "start" }), 300);
    return;
  }

  if (leftSign === "+" && (rightSphere > 5 || leftSphere > 5)) {
    grid.innerHTML = '<h1 class="recomment-headline">Our farsighted lenses go up to +5.00</h1>';
    const best = findMatchingMasks("+5.00","+5.00");
    if (best.matches.length) renderCards(best.matches, grid);
    return;
  }
  if (leftSign === "-" && (rightSphere > 9 || leftSphere > 9)) {
    grid.innerHTML = '<h1 class="recomment-headline">Our nearsighted lenses go up to -9.00</h1>';
    const best = findMatchingMasks("-9.00","-9.00");
    if (best.matches.length) renderCards(best.matches, grid);
    return;
  }

  const match = findMatchingMasks(adjLeft, adjRight);
  if (match.type === "minus" || match.type === "plus") {
    if (match.matches.length === 0) {
      grid.innerHTML = '<h1 class="recomment-headline">We could not find an exact match in the active catalog right now.</h1>';
    } else {
      const successHeader = createSuccessHeader(adjLeft, adjRight, match.matches.length);
      grid.appendChild(successHeader);
      renderCards(match.matches, grid);
      setTimeout(() => document.querySelector(".calculator-recommendations").scrollIntoView({ behavior: "smooth", block: "start" }), 300);
    }
  }
}

(function() {
  const GUTTER = 12;
  function clampTooltip(tip) {
    const bubble = tip.querySelector(".tooltiptext");
    if (!bubble) return;
    bubble.classList.add("measuring");
    bubble.style.display = "block";
    bubble.style.setProperty("--offset", "0px");
    void bubble.offsetHeight;
    const rect = bubble.getBoundingClientRect();
    let offset = 0;
    if (rect.left < GUTTER) offset = GUTTER - rect.left;
    else if (rect.right > (window.innerWidth - GUTTER)) offset = (window.innerWidth - GUTTER) - rect.right;
    bubble.style.setProperty("--offset", offset + "px");
    bubble.style.display = "";
    bubble.classList.remove("measuring");
  }
  function openTip(tip) { tip.classList.add("open"); clampTooltip(tip); }
  function closeAll(ex = null) {
    document.querySelectorAll(".tooltip.open").forEach(t => {
      if (ex && t === ex) return;
      t.classList.remove("open");
      const b = t.querySelector(".tooltiptext");
      if (b) b.style.setProperty("--offset", "0px");
    });
  }
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".tooltip").forEach(tip => {
      tip.addEventListener("click", e => {
        e.preventDefault();
        tip.classList.contains("open") ? tip.classList.remove("open") : (closeAll(tip), openTip(tip));
      });
      tip.addEventListener("mouseenter", () => clampTooltip(tip));
    });
    document.addEventListener("click", e => { if (!e.target.closest(".tooltip")) closeAll(); }, true);
    ["resize","scroll","orientationchange"].forEach(evt => {
      window.addEventListener(evt, () => document.querySelectorAll(".tooltip.open").forEach(clampTooltip));
    });
  });
})();
</script>

