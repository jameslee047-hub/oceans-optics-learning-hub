const swatchState = {};

function initSwatchState(mask) {
  if (!mask.swatches || swatchState[mask.name]) return;
  swatchState[mask.name] = { frame: mask.swatches.defaultFrame, seal: mask.swatches.defaultSeal };
}

function getVariantKey(mask) {
  if (!mask.swatches) return null;
  const s = swatchState[mask.name];
  if (!s) return null;
  return `${s.frame}/${s.seal}`;
}

function getVariantUrl(mask) {
  const key = getVariantKey(mask);
  if (!key || !mask.swatches) return mask.link;
  return mask.swatches.variantMap[key]?.url ?? mask.link;
}

function getVariantImg(mask) {
  const key = getVariantKey(mask);
  if (!key || !mask.swatches) return mask.img;
  return mask.swatches.variantMap[key]?.img ?? mask.img;
}

const priceCache = new Map();
async function fetchPriceHTML(mask) {
  if (!mask?.link) return "";
  if (priceCache.has(mask.link)) return priceCache.get(mask.link);
  try {
    const r = await fetch(mask.link + ".js");
    if (r.ok) {
      const data = await r.json();
      const cents = (data.variants || []).map(v => v.price).filter(Number.isFinite);
      const min = cents.length ? Math.min(...cents) : (Number.isFinite(data.price) ? data.price : null);
      if (Number.isFinite(min)) {
        const html = `<span class="price-chip">${(min/100).toLocaleString(undefined,{style:"currency",currency:"USD"})}</span>`;
        priceCache.set(mask.link, html);
        return html;
      }
    }
  } catch(e) {}
  priceCache.set(mask.link, "");
  return "";
}

function toggleSign(btn) {
  btn.classList.remove("notactivated");
  if (btn.innerText === "+/-") btn.innerText = "-";
  else if (btn.innerText === "-") btn.innerText = "+";
  else btn.innerText = "+/-";
}
function toggleCylSign(btn) {
  if (btn.innerText === "+/-") btn.innerText = "-";
  else if (btn.innerText === "-") btn.innerText = "+";
  else btn.innerText = "-";
}

const QUARTERS = ["00","25","50","75"];
const QUARTER_MAP = { "00":"0.00","25":"0.25","50":"0.50","75":"0.75" };

function buildIntOptions(sel) {
  sel.innerHTML = "";
  for (let i = 0; i <= 10; i++) {
    const o = document.createElement("option");
    o.value = String(i); o.textContent = i; sel.appendChild(o);
  }
}
function buildFracOptions(sel, allowAll = true) {
  sel.innerHTML = "";
  QUARTERS.forEach(q => {
    const o = document.createElement("option");
    o.value = q; o.textContent = q; sel.appendChild(o);
  });
  if (!allowAll) { sel.value = "00"; Array.from(sel.options).forEach(o => { if (o.value !== "00") o.disabled = true; }); }
}
function updateHidden(side) {
  const intSel = document.getElementById(side + "Int");
  const fracSel = document.getElementById(side + "Frac");
  const hidden = document.getElementById(side + "EyeSphere");
  const intVal = parseInt(intSel.value, 10);
  const frac = parseFloat(QUARTER_MAP[fracSel.value] || "0.00");
  if (intVal === 10 && fracSel.value !== "00") buildFracOptions(fracSel, false);
  hidden.value = (intVal + frac).toFixed(2);
}
function initPicker(side) {
  const intSel = document.getElementById(side + "Int");
  const fracSel = document.getElementById(side + "Frac");
  buildIntOptions(intSel); buildFracOptions(fracSel, true);
  intSel.value = "0"; fracSel.value = "00"; updateHidden(side);
  intSel.addEventListener("change", () => { buildFracOptions(fracSel, parseInt(intSel.value,10) < 10); updateHidden(side); });
  fracSel.addEventListener("change", () => updateHidden(side));
  [intSel, fracSel].forEach(sel => {
    sel.addEventListener("wheel", e => {
      e.preventDefault();
      const next = Math.max(0, Math.min(sel.options.length-1, sel.selectedIndex + Math.sign(e.deltaY)));
      sel.selectedIndex = next;
      sel.dispatchEvent(new Event("change", { bubbles: true }));
    }, { passive: false });
  });
}
document.addEventListener("DOMContentLoaded", () => { initPicker("left"); initPicker("right"); });

function buildSwatchSection(mask, card) {
  if (!mask.swatches) return null;
  initSwatchState(mask);
  const s = mask.swatches;
  const section = document.createElement("div");
  section.className = "swatch-section";

  function buildRow(label, colors, type) {
    const row = document.createElement("div");
    row.className = "swatch-row";
    const lbl = document.createElement("span");
    lbl.className = "swatch-row-label"; lbl.textContent = label;
    row.appendChild(lbl);
    const dots = document.createElement("div");
    dots.className = "swatch-dots";
    colors.forEach(color => {
      const btn = document.createElement("button");
      btn.className = "swatch-dot" + (LIGHT_COLORS.has(color) ? " light" : "");
      btn.style.background = COLOR_MAP[color] || "#ccc";
      btn.title = color;
      btn.setAttribute("data-color", color);
      btn.setAttribute("data-type", type);
      const isActive = type === "frame" ? swatchState[mask.name].frame === color : swatchState[mask.name].seal === color;
      if (isActive) btn.classList.add("active");
      btn.addEventListener("click", () => {
        if (type === "frame") {
          swatchState[mask.name].frame = color;
          const compatible = Object.keys(s.variantMap).some(k => k.startsWith(color+"/") && k.endsWith("/"+swatchState[mask.name].seal));
          if (!compatible) {
            const fb = Object.keys(s.variantMap).find(k => k.startsWith(color+"/"));
            if (fb) swatchState[mask.name].seal = fb.split("/")[1];
          }
        } else {
          swatchState[mask.name].seal = color;
          const compatible = Object.keys(s.variantMap).some(k => k.endsWith("/"+color) && k.startsWith(swatchState[mask.name].frame+"/"));
          if (!compatible) {
            const fb = Object.keys(s.variantMap).find(k => k.endsWith("/"+color));
            if (fb) swatchState[mask.name].frame = fb.split("/")[0];
          }
        }
        refreshCard(mask, card);
      });
      dots.appendChild(btn);
    });
    row.appendChild(dots);
    return row;
  }

  section.appendChild(buildRow("Frame", s.frameColors, "frame"));
  section.appendChild(buildRow("Seal", s.sealColors, "seal"));

  const selected = document.createElement("div");
  selected.className = "swatch-selected";
  selected.setAttribute("data-swatch-label", mask.name);
  selected.textContent = `${swatchState[mask.name].frame} frame / ${swatchState[mask.name].seal} seal`;
  section.appendChild(selected);
  return section;
}

function refreshCard(mask, card) {
  const url = getVariantUrl(mask);
  const img = getVariantImg(mask);
  card.querySelectorAll("a.btn").forEach(a => a.href = url);
  const imgEl = card.querySelector(".mask-image");
  if (imgEl && imgEl.src !== img) {
    imgEl.style.opacity = "0";
    setTimeout(() => { imgEl.src = img; imgEl.style.opacity = "1"; }, 150);
  }
  card.querySelectorAll(".swatch-dot").forEach(btn => {
    const color = btn.getAttribute("data-color");
    const type = btn.getAttribute("data-type");
    btn.classList.toggle("active", type === "frame" ? swatchState[mask.name].frame === color : swatchState[mask.name].seal === color);
  });
  const label = card.querySelector(`[data-swatch-label="${mask.name}"]`);
  if (label) label.textContent = `${swatchState[mask.name].frame} frame / ${swatchState[mask.name].seal} seal`;
}

