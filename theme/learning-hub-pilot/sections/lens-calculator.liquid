function parseSigned(str) {
  const s = String(str || "").trim();
  if (s === "0" || s === "0.00") return { sign: "zero", value: 0 };
  const sign = s.startsWith("+") ? "plus" : (s.startsWith("-") ? "minus" : "unknown");
  const value = Number(s.replace(/[^\d.]/g, ""));
  return { sign, value: Number.isFinite(value) ? value : 0 };
}
function supportsDiopter(mask, signedStr) {
  const parsed = parseSigned(signedStr);
  if (mask.lensType === "minus" && parsed.sign !== "minus") return false;
  if (mask.lensType === "plus" && parsed.sign !== "plus") return false;
  const abs = parsed.value;
  const low = Math.min(Math.abs(mask.diopterMin), Math.abs(mask.diopterMax));
  const high = Math.max(Math.abs(mask.diopterMin), Math.abs(mask.diopterMax));
  return abs >= low - 1e-9 && abs <= high + 1e-9;
}
function findMatchingMasks(leftStr, rightStr) {
  const L = parseSigned(leftStr);
  const R = parseSigned(rightStr);
  let effectiveSign = null;
  if (L.sign !== "zero") effectiveSign = L.sign;
  if (R.sign !== "zero") {
    if (effectiveSign && effectiveSign !== R.sign) return { type: "mixed", matches: [] };
    effectiveSign = R.sign;
  }
  if (!effectiveSign || (effectiveSign !== "minus" && effectiveSign !== "plus")) return { type: "invalid", matches: [] };
  const matches = maskData.filter(m => {
    if (effectiveSign === "minus" && m.lensType !== "minus") return false;
    if (effectiveSign === "plus" && m.lensType !== "plus") return false;
    const supportsLeft = L.sign === "zero" || supportsDiopter(m, leftStr);
    const supportsRight = R.sign === "zero" || supportsDiopter(m, rightStr);
    return supportsLeft && supportsRight;
  });
  return { type: effectiveSign, matches };
}

