      }
    },
    "multicolumn_YUXRqy": {
      "type": "multicolumn",
      "blocks": {
        "column_9NAJKp": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/Restores_habitat.png",
            "title": "<strong>Restores Marine Habitats</strong>",
            "title_h3": true,
            "text": "<p>Provides a stable foundation where corals can attach and grow, creating a new home for fish, crustaceans, and countless marine species.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_ThMr6A": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/Promotes_research.png",
            "title": "<strong>Promotes Research and Education </strong>",
            "title_h3": true,
            "text": "<p>Offers valuable opportunities for studying coral growth, reef restoration, and marine conservation.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_MfD6Yn": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/Eases_Pressure.png",
            "title": "<strong>Eases Pressure on Natural Reefs</strong>",
            "title_h3": true,
            "text": "<p>By creating an alternative habitat, it helps divert activitys such as diving away from fragile natural reefs, giving them time to recover.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_QHTzjH": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/Inspire_awarness.png",
            "title": "<strong>Inspires Ocean Awareness</strong>",
            "title_h3": true,
            "text": "<p>Projects like ours connect people to the ocean, showing how human creativity can play a role in restoring balance beneath the waves.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
