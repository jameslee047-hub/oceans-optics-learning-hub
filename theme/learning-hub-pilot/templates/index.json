        "heading_pF6Lhz": {
          "type": "heading",
          "settings": {
            "heading": "Buy a mask. Help grow a reef!",
            "heading_size": "h1"
          }
        },
        "text_GBFQP9": {
          "type": "text",
          "settings": {
            "text": "<p>Coral reefs cover just 1% of the ocean floor, yet support around 25% of all marine life. </p><p>They are one of the most important ecosystems on the planet, and they are under serious pressure. </p><p>That's why we choose to invest in real reef-building, planting and monitoring coral reefs in partnership with marine biologists and Thai coastal authorities. </p><p>One is already growing in the Gulf of Thailand. </p><p>More are coming soon!</p>",
            "text_style": "body"
          }
        },
        "button_xTRgTY": {
