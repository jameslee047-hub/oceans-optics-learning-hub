        "custom_liquid_peYpx3": {
          "type": "custom_liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "<div id=\"oo-store-credit\"></div>\n\n<script>\n(function () {\n  // Set your rule here:\n  // Example 1: percent back (5% back)\n  const percentBack = 0.05;\n\n  // Example 2: points per $1 (uncomment and use instead)\n  // const pointsPerDollar = 1;\n\n  function getCurrentPriceCents() {\n    // Most themes store current price in a price element with a data attribute or text.\n    // This tries a few common patterns.\n\n    const priceEl =\n      document.querySelector('[data-product-price]') ||\n      document.querySelector('.price__regular .price-item--regular') ||\n      document.querySelector('.price-item--regular') ||\n      document.querySelector('.price');\n\n    if (!priceEl) return null;\n\n    const txt = (priceEl.getAttribute('content') || priceEl.textContent || '').trim();\n\n    // Try to parse something like \"$123.45\"\n    const num = Number(txt.replace(/[^0-9.]/g, ''));\n    if (!Number.isFinite(num)) return null;\n\n    return Math.round(num * 100);\n  }\n\n  function render() {\n    const cents = getCurrentPriceCents();\n    if (cents == null) return;\n\n    const credit = (cents * percentBack) / 100;\n    const formatted = new Intl.NumberFormat(undefined, { style: \"currency\", currency: \"USD\" }).format(credit);\n\n    const box = document.getElementById(\"oo-store-credit\");\n    if (box) box.textContent = `Earn ${formatted} in store credit with this purchase`;\n  }\n\n  // Initial\n  render();\n\n  // Re-render when variants change\n  document.addEventListener(\"change\", (e) => {\n    const t = e.target;\n    if (!t) return;\n    if (t.matches('[name=\"id\"]') || t.closest('variant-selects, variant-radios')) {\n      setTimeout(render, 50);\n    }\n  });\n\n  document.addEventListener(\"variant:change\", () => setTimeout(render, 50));\n})();\n</script>"
