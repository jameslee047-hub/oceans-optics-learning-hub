  if(!root) return;\n\n  const tipHTML=`<span class=\"oo-tipwrap\">\n    <button class=\"oo-tip\" type=\"button\" aria-expanded=\"false\" aria-label=\"Black vs Clear Skirt\">?</button>\n    <span class=\"oo-bubble\" role=\"tooltip\">\n      <b>Black vs Clear skirt</b><br>\n      <b>Black:</b> Blocks side light in bright sun and helps you focus on what is ahead.<br>\n      <b>Clear:</b> Lets in more light for limited visibility. In very bright sun it can reflect your eyes on the lens, which some find distracting.\n    </span>\n  </span>`;\n\n  function attachTip(){\n    const labels=document.querySelectorAll(\n      '.product-form__input .form__label, .product-form__input legend, .product-form__input label, .product-form__input [data-option-name]'\n    );\n    for(const el of labels){\n      const t=(el.textContent||'').trim().toLowerCase();\n      if(/color|colour|pick your color|choose your color/.test(t) && !el.classList.contains('oo-has-tip')){\n        el.classList.add('oo-has-tip');\n        el.insertAdjacentHTML('beforeend', tipHTML);\n        break;\n      }\n    }\n  }\n\n  // Improved clamping: centers bubble under icon, then shifts to stay in viewport\n  function clampBubble(bubble){\n    if(!bubble) return;\n    \n    // Reset shift first\n    bubble.style.setProperty('--dx', '0px');\n    \n    // Force layout with visibility trick\n    const prevVis = bubble.style.visibility;\n    const prevOp = bubble.style.opacity;\n    bubble.style.visibility = 'hidden';\n    bubble.style.opacity = '0';\n    bubble.style.display = 'block';\n    \n    // Measure after a frame to ensure layout\n    requestAnimationFrame(() => {\n      const rect = bubble.getBoundingClientRect();\n      const gutter = 12; // px safety margin\n      let dx = 0;\n      \n      // Check left edge\n      if(rect.left < gutter){\n        dx = gutter - rect.left;\n      }\n      // Check right edge\n      else if(rect.right > window.innerWidth - gutter){\n        dx = (window.innerWidth - gutter) - rect.right;\n      }\n      \n      // Apply the shift\n      bubble.style.setProperty('--dx', Math.round(dx) + 'px');\n      \n      // Restore visibility\n      bubble.style.visibility = prevVis;\n      bubble.style.opacity = prevOp;\n    });\n  }\n\n  attachTip();\n  const mo=new MutationObserver(attachTip);\n  mo.observe(document.body,{subtree:true,childList:true});\n\n  // Toggle + clamp on open; close on outside click / Esc\n  root.addEventListener('click',e=>{\n    const btn=e.target.closest('.oo-tip');\n    if(btn){\n      const open = btn.getAttribute('aria-expanded')==='true';\n      // Close all others first\n      document.querySelectorAll('.oo-tip[aria-expanded=\"true\"]').forEach(x=>{\n        if(x !== btn) x.setAttribute('aria-expanded','false');\n      });\n      \n      // Toggle this one\n      const newState = open ? 'false' : 'true';\n      btn.setAttribute('aria-expanded', newState);\n      \n      // Clamp if opening\n      if(newState === 'true'){\n        const bubble = btn.nextElementSibling;\n        setTimeout(() => clampBubble(bubble), 10);\n      }\n      \n      e.stopPropagation();\n      return;\n    }\n    // Click outside - close all\n    document.querySelectorAll('.oo-tip[aria-expanded=\"true\"]').forEach(x=>x.setAttribute('aria-expanded','false'));\n  });\n\n  root.addEventListener('keyup',e=>{\n    if(e.key==='Escape'){\n      document.querySelectorAll('.oo-tip[aria-expanded=\"true\"]').forEach(x=>x.setAttribute('aria-expanded','false'));\n    }\n  });\n\n  // Reclamp on resize\n  window.addEventListener('resize',()=>{\n    root.querySelectorAll('.oo-tip[aria-expanded=\"true\"] + .oo-bubble').forEach(clampBubble);\n  });\n})();\n</script>"
