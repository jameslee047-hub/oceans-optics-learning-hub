            "title_h3": false,
            "text": "<p>✓ More relaxed vision<br/><br/>✓ Less eye strain on 60-90 minute snorkels<br/><br/>✓ Fewer headaches for sensitive people<br/><br/>✗ Some fine detail softness (gauges, small fish)<br/><br/>✗ More blur if CYL is moderate to high</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_CAEgYL": {
          "type": "column",
          "settings": {
            "title": "<strong>If You Stay at Your Exact SPH:</strong>",
            "title_h3": false,
            "text": "<p>✓ Familiar, predictable vision<br/><br/>✓ Sharper detail for gauges or photography<br/><br/>✓ Great clarity on the surface<br/><br/>✗ Can feel \"too strong\" underwater<br/><br/>✗ More fatigue on long sessions<br/><br/>✗ Higher headache risk</p>",
            "link_label": "",
            "link": ""
          }
