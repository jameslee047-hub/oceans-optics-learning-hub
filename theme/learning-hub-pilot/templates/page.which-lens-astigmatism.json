      "blocks": {
        "collapsible_row_q9TBwW": {
          "type": "collapsible_row",
          "settings": {
            "heading": "LOW CYL (0.00 to 0.75)",
            "icon": "eye",
            "row_content": "<p><strong>Comfort Start:</strong> Go 0.25 to 0.50 weaker than SPH<br/><strong>Sharper Option:</strong> Stay at your SPH</p><p>Example:<br/><br/><strong>SPH −3.00, CYL −0.50</strong></p><p><br/>→ Try −2.50 for comfort<br/>→ Try −3.00 for sharpness (comfort warning)</p>",
            "page": ""
          }
        },
        "collapsible_row_XFKnc6": {
          "type": "collapsible_row",
          "settings": {
            "heading": "MODERATE CYL (1.00 to 1.75)",
            "icon": "eye",
            "row_content": "<p><strong>Comfort Start:</strong> SPH or only 0.25 weaker max<br/><strong>Don't Go:</strong> More than 0.50 weaker</p><p>Example:<br/><br/><strong>SPH −3.75, CYL −1.50</strong><br/></p><p>→ Try −3.50<br/>→ Avoid 3.00 (too soft)</p>",
            "page": ""
          }
        },
        "collapsible_row_Kfrar8": {
          "type": "collapsible_row",
          "settings": {
            "heading": "HIGH CYL (2.00 to 3.00)",
            "icon": "eye",
            "row_content": "<p><strong>Comfort Start:</strong> Keep SPH  the same<br/><strong>Sharper Option:</strong> Stay at SPH or round up by 0.25 max. (Comfort Warnign when rounding up.</p><p><span style=\"text-decoration:underline\">Example 1:</span><br/></p><p><strong>SPH −2.50, CYL −2.25<br/></strong></p><p>→ Choose −2.50 for comfort<br/>→ Choose  −3.00 for sharpnes</p><p><span style=\"text-decoration:underline\">Example 2:</span></p><p><strong>SPH −2.75, CYL −2.50</strong></p><p>→ Choose −3.00 for sharpness</p><p></p>",
            "page": ""
          }
        },
        "collapsible_row_ApmUbJ": {
          "type": "collapsible_row",
          "settings": {
            "heading": "VERY HIGH CYL (3.25+)",
            "icon": "eye",
            "row_content": "<p><strong>Comfort Start: </strong>Stay at Sphere<br/><strong>Crisp Option:</strong> Go 0.25-0.50 higher than sphere.</p><p><strong>Example 1:</strong><br/><br/>SPH −2.75, CYL −3.00<br/><br/>→ Best option −3.00</p><p></p><p><strong>Example 2:</strong><br/><br/>SPH −0.50, CYL −3.50<br/><br/>→ Best option −1.00</p>",
            "page": ""
          }
        }
