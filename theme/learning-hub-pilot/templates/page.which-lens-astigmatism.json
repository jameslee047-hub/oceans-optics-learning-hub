        "button_LzWhcY"
      ],
      "custom_css": [],
      "name": "t:sections.image-with-text.presets.name",
      "settings": {
        "image": "shopify://shop_images/How_prescrption_snorkel_mask_work_underwater_e269956b-9417-4511-9f31-a6ffe7e10c4c.png",
