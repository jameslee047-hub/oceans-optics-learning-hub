        },
        "text_AXYYw4": {
          "type": "text",
          "settings": {
            "text": "<p><strong>You may get:</strong></p><p>✅ Sharper edges and detail</p><p>✅ Less soft blur with high CYL</p><p><strong>But risk increases for:</strong></p><p>❌ Eye strain on long snorkels</p><p>❌ Headaches</p><p>❌ \"Too strong\" sensation underwater</p><p><span style=\"text-decoration:underline\"><strong>My instructor rule: <br/></strong></span></p><p><strong>Short, detail-heavy sessions</strong> (photography, navigation): crisp can be worth it.</p><p><strong>Long snorkels, casual diving</strong>: comfort usually wins.</p><p>Adding +0.25 to your sphere is a very small change and should feel comfortable with minimal discomfort</p>"
          }
        }
