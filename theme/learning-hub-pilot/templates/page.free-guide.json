          }
        },
        "column_qXJhcR": {
          "type": "column",
          "settings": {
            "title": "Breath hold techniques",
            "title_h3": false,
            "text": "<p>Gain insights into the physiology behind holding your breath underwater. Learn techniques to extend your breath-hold safely, enhancing your ability to explore beneath the surface.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_fBzQLR": {
          "type": "column",
          "settings": {
            "title": "<strong>Exploring Water Dynamics</strong>",
            "title_h3": false,
            "text": "<p>Learn about the fascinating world of water movement, tides, and their influence on marine ecosystems. This section simplifies ocean currents and tidal patterns, equipping you with the knowledge to safely sync with the sea's natural rhythms during your snorkeling adventures.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
