      "type": "multicolumn",
      "blocks": {
        "column_nXc8dU": {
          "type": "column",
          "settings": {
            "title": "<strong>Extended Academic Insights</strong>",
            "title_h3": false,
            "text": "<p>This is where we get a little nerdy with our science. Delve into the physics and physiology aspects crucial for snorkelers, offering a comprehensive understanding of the affects of pressure and being in the water on our body.</p>",
