        "custom_liquid_QGa4e6": {
          "type": "custom_liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "<div class=\"flash-sale-timer-container\" id=\"flash-sale-container\">\n  <h2><a href=\"https://www.oceansoptics.com/collections/Flash-Sale\" class=\"flash-sale-link\">FLASH SALE ENDS IN</a></h2>\n  <div id=\"countdown\">\n    <div class=\"time-box\">\n      <div class=\"label\">Days</div>\n      <div class=\"flip clock\" id=\"days\">\n        <div class=\"card front\"></div>\n        <div class=\"card back\"></div>\n      </div>\n    </div>\n    <div class=\"separator\">:</div>\n    <div class=\"time-box\">\n      <div class=\"label\">Hours</div>\n      <div class=\"flip clock\" id=\"hours\">\n        <div class=\"card front\"></div>\n        <div class=\"card back\"></div>\n      </div>\n    </div>\n    <div class=\"separator\">:</div>\n    <div class=\"time-box\">\n      <div class=\"label\">Mins</div>\n      <div class=\"flip clock\" id=\"minutes\">\n        <div class=\"card front\"></div>\n        <div class=\"card back\"></div>\n      </div>\n    </div>\n    <div class=\"separator\">:</div>\n    <div class=\"time-box\">\n      <div class=\"label\">Secs</div>\n      <div class=\"flip orange clock\" id=\"seconds\">\n        <div class=\"card front\"></div>\n        <div class=\"card back\"></div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .flash-sale-timer-container {\n    text-align: center;\n    background-color: #ffffff;\n    color: #023059;\n    padding: 10px;\n    width: 100%;\n    box-sizing: border-box;\n  }\n  .flash-sale-link {\n    text-decoration: none;\n    color: inherit;\n  }\n  .flash-sale-timer-container h2 {\n    color: #B95E05;\n    font-size: 1em;\n    margin-bottom: 2px;\n  }\n  #countdown {\n    display: flex;\n    justify-content: center;\n    gap: 4px;\n    margin-top: 10px;\n  }\n  .time-box {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n  }\n  .label {\n    font-size: 0.7em;\n    margin-bottom: 2px;\n  }\n  .flip {\n    position: relative;\n    width: 40px;\n    height: 50px;\n    perspective: 600px;\n  }\n  .card {\n    position: absolute;\n    width: 100%;\n    height: 100%;\n    background-color: #023059;\n    color: #ffffff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    backface-visibility: hidden;\n    border-radius: 4px;\n    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.3);\n    font-size: 1.5em;\n    font-family: 'Courier New', Courier, monospace;\n  }\n  .flip.orange .card {\n    background-color: #ffa500;\n  }\n  .card.back {\n    transform: rotateX(180deg);\n  }\n  .flip.flipping .card.front {\n    transform: rotateX(-180deg);\n    transition: transform 0.8s ease-in-out;\n  }\n  .flip.flipping .card.back {\n    transform: rotateX(0deg);\n    transition: transform 0.8s ease-in-out;\n  }\n  .separator {\n    font-size: 2em;\n    align-self: center;\n    font-family: 'Courier New', Courier, monospace;\n  }\n</style>\n\n<script>\n  (function() {\n    const countdownDate = new Date(\"2024-10-07T23:59:59\").getTime();\n\n    function updateFlip(elementId, value) {\n      const flipElement = document.getElementById(elementId);\n      const frontCard = flipElement.querySelector('.card.front');\n      const backCard = flipElement.querySelector('.card.back');\n      const currentValue = flipElement.dataset.value;\n      const formattedValue = value.toString().padStart(2, '0');\n      if (currentValue !== formattedValue) {\n        flipElement.dataset.value = formattedValue;\n        backCard.innerText = formattedValue;\n        flipElement.classList.add(\"flipping\");\n        setTimeout(() => {\n          frontCard.innerText = formattedValue;\n          flipElement.classList.remove(\"flipping\");\n        }, 800);\n      }\n    }\n\n    const countdownFunction = setInterval(function() {\n      const now = new Date().getTime();\n      const distance = countdownDate - now;\n\n      const days = Math.floor(distance / (1000 * 60 * 60 * 24));\n      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));\n      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));\n      const seconds = Math.floor((distance % (1000 * 60)) / 1000);\n\n      updateFlip(\"days\", days);\n      updateFlip(\"hours\", hours);\n      updateFlip(\"minutes\", minutes);\n      updateFlip(\"seconds\", seconds);\n\n      if (distance < 0) {\n        clearInterval(countdownFunction);\n        document.getElementById(\"flash-sale-container\").style.display = \"none\";\n      }\n    }, 1000);\n  })();\n</script>"
          }
