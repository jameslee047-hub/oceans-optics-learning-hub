{% doc %}
  @prompt
    can we make a back to shopping button, that will just take the customer back to where they were when they added the item, i need to be able to adjust the section padding avobe and bleow it, and also be able to move it accross the horizontal plane
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-back-to-shopping-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    text-align: {{ block.settings.horizontal_alignment }};
  }

  .ai-back-to-shopping-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding | times: 1.5 }}px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    font-size: {{ block.settings.font_size }}px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: inherit;
  }

  .ai-back-to-shopping-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.border_hover_color }};
  }

  .ai-back-to-shopping-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-back-to-shopping-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
  }

  @media screen and (max-width: 749px) {
    .ai-back-to-shopping-{{ ai_gen_id }} {
      width: 100%;
      padding-top: {{ block.settings.padding_top_mobile }}px;
      padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<back-to-shopping-{{ ai_gen_id }}
  class="ai-back-to-shopping-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <a
    href="#"
    class="ai-back-to-shopping-button-{{ ai_gen_id }}"
    data-back-button
  >
    <span class="ai-back-to-shopping-icon-{{ ai_gen_id }}">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
    </span>
    <span>{{ block.settings.button_text }}</span>
  </a>
</back-to-shopping-{{ ai_gen_id }}>

<script>
  (function() {
    class BackToShopping{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.button = this.querySelector('[data-back-button]');
        if (this.button) {
          this.setupButton();
        }
      }

      setupButton() {
        const referrer = document.referrer;
        const currentDomain = window.location.hostname;
        const fallbackUrl = '{{ block.settings.fallback_url | default: routes.all_products_collection_url }}';

        if (referrer && referrer.includes(currentDomain)) {
          this.button.href = referrer;
        } else {
          this.button.href = fallbackUrl;
        }

        this.button.addEventListener('click', function(event) {
          if (window.history.length > 1 && document.referrer.includes(currentDomain)) {
            event.preventDefault();
            window.history.back();
          }
        });
      }
    }

    customElements.define('back-to-shopping-{{ ai_gen_id }}', BackToShopping{{ ai_gen_id }});
  })();
</script>

