{{ 'oo-cropper-1.6.2.min.css' | asset_url | stylesheet_tag }}
{{ 'oo-product-rx-checker-v53.css' | asset_url | stylesheet_tag }}

<section
  class="oo-rx-checker"
  id="oo-rx-checker-{{ section.id }}"
  data-oo-product-rx-checker
  data-product-handle="{{ product.handle | escape }}"
  data-pdfjs-src="{{ 'oo-pdfjs-3.11.174.min.js' | asset_url }}"
  data-pdfjs-worker="{{ 'oo-pdfjs-3.11.174.worker.min.js' | asset_url }}"
  aria-labelledby="oo-rx-checker-title-{{ section.id }}"
  aria-busy="false"
>
  <h2 class="oo-rx-checker__title" id="oo-rx-checker-title-{{ section.id }}">Underwater Lens Calculator</h2>

  <div class="oo-rx-checker__box">
    <p class="oo-rx-checker__intro">Enter or upload your prescription to find your recommended underwater lens strength for this mask.</p>

    <div class="oo-rx-checker__upload">
      <label class="oo-rx-checker__upload-button" for="oo-rx-checker-file-{{ section.id }}">Upload prescription</label>
      <input
        class="oo-rx-checker__file"
        id="oo-rx-checker-file-{{ section.id }}"
        type="file"
        accept="image/jpeg,image/png,image/webp,image/gif,application/pdf"
        data-checker-file
      >
      <span class="oo-rx-checker__divider">or enter it below</span>
    </div>

    <div class="oo-rx-checker__review" data-checker-review hidden>
      <p class="oo-rx-checker__review-title">Crop to just your prescription</p>
      <p class="oo-rx-checker__review-help">Drag the corners to select only the prescription values. Remove names, addresses and anything else you don't want to send. Only the selected area is uploaded.</p>
      <label class="oo-rx-checker__pages" data-checker-pages hidden>
        PDF page
        <select data-checker-page aria-label="PDF page"></select>
      </label>
      <div class="oo-rx-checker__crop">
        <img alt="Prescription to crop" width="1200" height="1600" data-checker-crop-image>
      </div>
      <div class="oo-rx-checker__crop-tools">
        <button type="button" class="oo-rx-checker__tool" data-checker-rotate-left>Rotate left</button>
        <button type="button" class="oo-rx-checker__tool" data-checker-rotate-right>Rotate right</button>
        <button type="button" class="oo-rx-checker__tool" data-checker-reset>Reset</button>
      </div>
      <button type="button" class="oo-rx-checker__use" data-checker-use disabled>Use this area</button>
      <div class="oo-rx-checker__crop-tools">
        <button type="button" class="oo-rx-checker__tool" data-checker-choose-another>Choose another file</button>
        <button type="button" class="oo-rx-checker__tool" data-checker-cancel>Cancel</button>
      </div>
    </div>

    <form class="oo-rx-checker__form" data-checker-form novalidate>
      <div class="oo-rx-checker__eyes">
      <div class="oo-rx-checker__eye" data-eye="right">
        <span class="oo-rx-checker__eye-title">Sphere Right (OD)</span>
        <div class="oo-rx-checker__sph">
          <button type="button" class="oo-rx-checker__sign" data-sign="" data-sphere-sign aria-label="Right (OD) sphere sign: choose + or −">+/-</button>
          <span class="oo-rx-checker__picker">
            <select data-sphere-int aria-label="Right (OD) sphere whole number"></select>
            <span class="oo-rx-checker__dot" aria-hidden="true">.</span>
            <select data-sphere-frac aria-label="Right (OD) sphere decimal"></select>
          </span>
          <input type="hidden" data-field="sphere" value="">
        </div>
        <div class="oo-rx-checker__row">
          <span class="oo-rx-checker__row-label">CYL:</span>
          <button type="button" class="oo-rx-checker__row-sign" data-sign="" data-cyl-sign aria-label="Right (OD) cylinder sign: choose + or −">+/-</button>
          <select data-cyl-mag aria-label="Right (OD) cylinder"></select>
          <input type="hidden" data-field="cylinder" value="0">
        </div>
        <div class="oo-rx-checker__row">
          <span class="oo-rx-checker__row-label">AXIS:</span>
          <select data-field="axis" aria-label="Right (OD) axis"></select>
        </div>
      </div>
      <div class="oo-rx-checker__eye" data-eye="left">
        <span class="oo-rx-checker__eye-title">Sphere Left (OS)</span>
        <div class="oo-rx-checker__sph">
          <button type="button" class="oo-rx-checker__sign" data-sign="" data-sphere-sign aria-label="Left (OS) sphere sign: choose + or −">+/-</button>
          <span class="oo-rx-checker__picker">
            <select data-sphere-int aria-label="Left (OS) sphere whole number"></select>
            <span class="oo-rx-checker__dot" aria-hidden="true">.</span>
            <select data-sphere-frac aria-label="Left (OS) sphere decimal"></select>
          </span>
          <input type="hidden" data-field="sphere" value="">
        </div>
        <div class="oo-rx-checker__row">
          <span class="oo-rx-checker__row-label">CYL:</span>
          <button type="button" class="oo-rx-checker__row-sign" data-sign="" data-cyl-sign aria-label="Left (OS) cylinder sign: choose + or −">+/-</button>
          <select data-cyl-mag aria-label="Left (OS) cylinder"></select>
          <input type="hidden" data-field="cylinder" value="0">
        </div>
        <div class="oo-rx-checker__row">
          <span class="oo-rx-checker__row-label">AXIS:</span>
          <select data-field="axis" aria-label="Left (OS) axis"></select>
        </div>
      </div>
      </div>

      <label class="oo-rx-checker__label-field" for="oo-rx-checker-label-{{ section.id }}">
        Who is this prescription for? <span>(optional)</span>
        <input class="oo-rx-checker__label-input" id="oo-rx-checker-label-{{ section.id }}" type="text" maxlength="60" autocomplete="off" placeholder="e.g. James" data-checker-label>
      </label>

      <button class="oo-rx-checker__check" type="submit" data-checker-check>Find My Lens Strength</button>
    </form>

    <p class="oo-rx-checker__status" data-checker-status role="status" aria-live="polite" hidden></p>
    <div class="oo-rx-checker__result" data-checker-result aria-live="polite" hidden></div>
  </div>
</section>

<script src="{{ 'oo-cropper-1.6.2.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'oo-lens-calculator-v53-base.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'oo-lens-calculator-v53-engine.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'oo-lens-calculator-v53-high-cyl.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'oo-lens-calculator-v53-rx.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'oo-lens-calculator-v53-products.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'oo-product-rx-checker-v53.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "V5.3 Product Rx Checker",
  "tag": "div",
  "class": "oo-product-rx-checker-v53-section",
  "settings": [],
  "presets": [
    {
      "name": "V5.3 Product Rx Checker"
    }
  ]
}
{% endschema %}
