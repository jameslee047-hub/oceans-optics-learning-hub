        "collapsible_tab_3pcVAN": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Mask Description",
            "heading_not_h2": false,
            "icon": "clipboard",
            "content": "<h5>This low-volume, medium-sized mask accommodates a variety of face shapes, including wide, round, and narrow profiles. Its double silicone seal ensures a dry, leak-free fit, while the hypoallergenic soft silicone skirt provides lasting comfort for extended underwater adventures.</h5><h5><strong>Perfect for Correcting Vision for Divers and Snorkelers</strong></h5><h5>RX Lumix features prescription lenses ranging from -1.5 to -6.0 diopters. </h5><h5>Experience crystal-clear vision without the need for additional eyewear, allowing you to explore vibrant coral reefs and deep blue waters with precision and ease.</h5>",
            "page": ""
          }
        },
        "collapsible_tab_TJ4w9q": {
          "type": "collapsible_tab",
          "disabled": true,
          "settings": {
            "heading": "Specifications & Features",
            "heading_not_h2": false,
            "icon": "lightning_bolt",
            "content": "<h5><strong>Benefits:</strong></h5><p><strong>Double Silicone Seal Skirt</strong></p><p><strong>Leak-Free Comfort:</strong> Soft liquid silicone molds to your face, preventing water entry and enhancing comfort during long dives.</p><p><strong>Tempered Glass Prescription Lenses</strong></p><p><strong>Sharp Vision:</strong> Available in -1.5 to -6.0 diopters (0.5 increments) for clear, distortion-free underwater sight.</p><p><strong>Durable Aluminum Alloy Frame</strong></p><p><strong>Lightweight Strength:</strong> Combines durability with a sleek design, ensuring long-lasting performance even in demanding conditions.</p><p><strong>Adjustable Straps</strong></p><p><strong>Easy Fit:</strong> Easily adjust straps for a secure hold, providing stability throughout your dive.</p><p><strong>Wide Peripheral View</strong></p><p><strong>Immersive Experience:</strong> Enjoy an expansive field of vision, allowing you to take in the underwater landscape without eye strain.</p><p><strong>Specifications:</strong></p><p><strong>Frame Material:</strong> Aluminum Alloy</p><p><strong>Lens Material:</strong> Tempered Glass (-1.5 to -6.0 diopters)</p><p><strong>Skirt Material:</strong> Liquid Silicone</p><p><strong>Tube Type:</strong> Wet Style Snorkel</p><p><strong>Weight:</strong> 7 oz (198.5 g)</p><p><strong>Suitable For:</strong> Adults and Youth (Small to Medium Faces)</p><h5></h5>",
            "page": ""
          }
        },
