          "settings": {
            "custom_liquid": "<style>\n  /* Scoped to THIS Custom Liquid only */\n  #shopify-section-{{ section.id }} .oo-tipwrap{\n    display:inline-flex; align-items:center; gap:6px; margin-left:6px; position:relative;\n  }\n  #shopify-section-{{ section.id }} .oo-tip{\n    width:16px; height:16px; border:0; border-radius:999px;\n    background:#808080; color:#fff; cursor:pointer;\n    font:1000 12px/1 Lato,system-ui,sans-serif; display:inline-flex; align-items:center; justify-content:center;\n  }\n  #shopify-section-{{ section.id }} .oo-bubble{\n    position:absolute; z-index:999; \n    /* Center under icon by default, then shift with --dx */\n    left:50%; top:100%; \n    --dx: 0px;\n    transform:translate(calc(-50% + var(--dx)), 8px);\n    display:block; min-width:320px; max-width:420px;\n    padding:10px 12px; border-radius:10px; background:#023059; color:#fff; \n    box-shadow:0 8px 20px rgba(2,48,89,.18);\n    line-height:1.40; font-size:11px; text-align:left;\n    white-space:normal; word-break:normal; overflow-wrap:break-word;\n    opacity:0; visibility:hidden; transition:.15s ease;\n    pointer-events:none;\n  }\n  #shopify-section-{{ section.id }} .oo-tip[aria-expanded=\"true\"] + .oo-bubble{\n    opacity:1; visibility:visible; \n    transform:translate(calc(-50% + var(--dx)), 4px);\n    pointer-events:auto;\n  }\n  /* Arrow stays centered relative to shifted bubble */\n  #shopify-section-{{ section.id }} .oo-bubble:after{\n    content:\"\"; position:absolute; top:-6px;\n    /* Arrow stays near center, accounting for the dx shift */\n    left:calc(50% - var(--dx));\n    border:6px solid transparent; border-bottom-color:#023059;\n  }\n\n  /* Mobile: allow smaller width */\n  @media (max-width:749px){\n    #shopify-section-{{ section.id }} .oo-bubble{ \n      min-width:240px; \n      max-width:calc(100vw - 24px); \n      font-size:12px;\n    }\n  }\n</style>\n\n<script>\n(()=>{\n  const root=document.getElementById('shopify-section-{{ section.id }}'); \n  if(!root) return;\n\n  const tipHTML=`<span class=\"oo-tipwrap\">\n    <button class=\"oo-tip\" type=\"button\" aria-expanded=\"false\" aria-label=\"Black vs Clear Skirt\">?</button>\n    <span class=\"oo-bubble\" role=\"tooltip\">\n      <b>Black vs Clear skirt</b><br>\n      <b>Black:</b> Blocks side light in bright sun and helps you focus on what is ahead.<br>\n      <b>Clear:</b> Lets in more light for limited visibility. In very bright sun it can reflect your eyes on the lens, which some find distracting.\n    </span>\n  </span>`;\n\n  function attachTip(){\n    const labels=document.querySelectorAll(\n      '.product-form__input .form__label, .product-form__input legend, .product-form__input label, .product-form__input [data-option-name]'\n    );\n    for(const el of labels){\n      const t=(el.textContent||'').trim().toLowerCase();\n      if(/color|colour|pick your color|choose your color/.test(t) && !el.classList.contains('oo-has-tip')){\n        el.classList.add('oo-has-tip');\n        el.insertAdjacentHTML('beforeend', tipHTML);\n        break;\n      }\n    }\n  }\n\n  // Improved clamping: centers bubble under icon, then shifts to stay in viewport\n  function clampBubble(bubble){\n    if(!bubble) return;\n    \n    // Reset shift first\n    bubble.style.setProperty('--dx', '0px');\n    \n    // Force layout with visibility trick\n    const prevVis = bubble.style.visibility;\n    const prevOp = bubble.style.opacity;\n    bubble.style.visibility = 'hidden';\n    bubble.style.opacity = '0';\n    bubble.style.display = 'block';\n    \n    // Measure after a frame to ensure layout\n    requestAnimationFrame(() => {\n      const rect = bubble.getBoundingClientRect();\n      const gutter = 12; // px safety margin\n      let dx = 0;\n      \n      // Check left edge\n      if(rect.left < gutter){\n        dx = gutter - rect.left;\n      }\n      // Check right edge\n      else if(rect.right > window.innerWidth - gutter){\n        dx = (window.innerWidth - gutter) - rect.right;\n      }\n      \n      // Apply the shift\n      bubble.style.setProperty('--dx', Math.round(dx) + 'px');\n      \n      // Restore visibility\n      bubble.style.visibility = prevVis;\n      bubble.style.opacity = prevOp;\n    });\n  }\n\n  attachTip();\n  const mo=new MutationObserver(attachTip);\n  mo.observe(document.body,{subtree:true,childList:true});\n\n  // Toggle + clamp on open; close on outside click / Esc\n  root.addEventListener('click',e=>{\n    const btn=e.target.closest('.oo-tip');\n    if(btn){\n      const open = btn.getAttribute('aria-expanded')==='true';\n      // Close all others first\n      document.querySelectorAll('.oo-tip[aria-expanded=\"true\"]').forEach(x=>{\n        if(x !== btn) x.setAttribute('aria-expanded','false');\n      });\n      \n      // Toggle this one\n      const newState = open ? 'false' : 'true';\n      btn.setAttribute('aria-expanded', newState);\n      \n      // Clamp if opening\n      if(newState === 'true'){\n        const bubble = btn.nextElementSibling;\n        setTimeout(() => clampBubble(bubble), 10);\n      }\n      \n      e.stopPropagation();\n      return;\n    }\n    // Click outside - close all\n    document.querySelectorAll('.oo-tip[aria-expanded=\"true\"]').forEach(x=>x.setAttribute('aria-expanded','false'));\n  });\n\n  root.addEventListener('keyup',e=>{\n    if(e.key==='Escape'){\n      document.querySelectorAll('.oo-tip[aria-expanded=\"true\"]').forEach(x=>x.setAttribute('aria-expanded','false'));\n    }\n  });\n\n  // Reclamp on resize\n  window.addEventListener('resize',()=>{\n    root.querySelectorAll('.oo-tip[aria-expanded=\"true\"] + .oo-bubble').forEach(clampBubble);\n  });\n})();\n</script>"
