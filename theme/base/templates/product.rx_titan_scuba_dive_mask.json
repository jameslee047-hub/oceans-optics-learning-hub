        "collapsible_tab_wEGU7X": {
          "type": "collapsible_tab",
          "name": "Mask description",
          "settings": {
            "heading": "Mask Description",
            "heading_not_h2": false,
            "icon": "clipboard",
            "content": "<p><strong>The RX Titan Prescription Mask for Nearsighted Divers and Snorkelers</strong> is built for underwater adventurers who need clear vision and a roomier, more comfortable mask fit.</p><p>Designed with corrective tempered glass lenses for nearsighted vision, the RX Titan helps you see clearly underwater without contact lenses or blurry views.</p><p>Its larger frame, soft silicone skirt, and wider nose pocket make it ideal for medium to large face shapes, especially for customers who find standard masks too narrow or tight around the nose.</p><p>The wide viewing field keeps more of the underwater world in sight, while the easy-adjust buckles and comfortable nose pocket make it suitable for snorkeling, freediving, and scuba diving.</p>",
            "page": ""
          }
        },
        "collapsible_tab_3hCXce": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Prescription Lens Info",
            "heading_not_h2": false,
            "icon": "eye",
            "content": "<p>This mask features Myopia/Nearsighted (SPH) lenses in negative diopters, available in increments of 0.50 (e.g. –1.50, –2.00, –2.50). Each lens is made from tempered glass for clarity and safety, and clear underwater vision.</p><p>👉 <a href=\"https://oceansoptics.com/pages/prescription-lenses\" target=\"_blank\">[Not sure which strength to choose? Try our Lens Calculator Tool ›]</a></p>",
            "page": ""
          }
        },
        "collapsible_tab_c6hiee": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Features & Benefits",
            "heading_not_h2": false,
            "icon": "star",
            "content": "<p>Corrective lenses built for nearsighted vision, available from <strong>-1.50 to -7.00</strong></p><p>Option to choose <strong>no correction</strong> for either eye</p><p>Different lens strengths can be selected for the left and right eye</p><p>Roomier fit for medium to large face shapes</p><p>Wider silicone seal for broader faces and cheekbones</p><p>Soft silicone skirt for a secure, comfortable seal</p><p>Wider nose pocket for extra comfort and easier equalizing</p><p>Twin tempered glass lenses for clear underwater vision</p><p>Wide viewing field to stay aware of your surroundings</p><p>Durable design for snorkeling, freediving, and scuba diving</p><p>Simple buckle system for quick strap adjustments</p>",
            "page": ""
          }
        },
