        "custom_liquid_fxG84K": {
          "type": "custom_liquid",
          "name": "Waitlist",
          "disabled": true,
          "settings": {
            "custom_liquid": "<style>\n  .oo-waitlist {\n    border: 1px solid rgba(2, 48, 89, 0.25);\n    border-radius: 18px;\n    padding: 18px;\n    margin-top: 14px;\n    background: #fff;\n  }\n  .oo-waitlist h3 {\n    margin: 0 0 6px 0;\n    font-size: 16px;\n    line-height: 1.2;\n    color: #023059;\n    font-weight: 900;\n  }\n  .oo-waitlist p {\n    margin: 0 0 12px 0;\n    font-size: 13.5px;\n    line-height: 1.4;\n    color: #023059;\n    opacity: 0.92;\n  }\n  .oo-waitlist details { margin-top: 10px; }\n  .oo-waitlist summary {\n    list-style: none;\n    cursor: pointer;\n    user-select: none;\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    border: 2px solid #023059;\n    color: #023059;\n    background: #fff;\n    padding: 10px 14px;\n    border-radius: 999px;\n    font-weight: 900;\n    font-size: 13px;\n  }\n  .oo-waitlist summary::-webkit-details-marker { display: none; }\n\n  .oo-waitlist-form {\n    margin-top: 12px;\n    display: grid;\n    gap: 10px;\n  }\n  .oo-waitlist-row { display: grid; gap: 10px; }\n  @media (min-width: 640px) {\n    .oo-waitlist-row { grid-template-columns: 1fr 1fr; }\n  }\n  .oo-waitlist input {\n    width: 100%;\n    border: 1px solid rgba(2, 48, 89, 0.25);\n    border-radius: 12px;\n    padding: 11px 12px;\n    font-size: 14px;\n    outline: none;\n  }\n  .oo-waitlist input:focus {\n    border-color: rgba(2, 48, 89, 0.6);\n    box-shadow: 0 0 0 3px rgba(2, 48, 89, 0.08);\n  }\n  .oo-waitlist button {\n    width: 100%;\n    border: none;\n    border-radius: 999px;\n    padding: 12px 14px;\n    font-size: 14px;\n    font-weight: 1000;\n    background: #B95E05;\n    color: #fff;\n    cursor: pointer;\n  }\n  .oo-waitlist small {\n    display: block;\n    font-size: 12px;\n    opacity: 0.9;\n    color: #023059;\n    margin-top: 8px;\n  }\n  .oo-waitlist .oo-success,\n  .oo-waitlist .oo-error {\n    border-radius: 12px;\n    padding: 10px 12px;\n    font-size: 13px;\n    margin-top: 10px;\n  }\n  .oo-waitlist .oo-success {\n    background: rgba(185, 94, 5, 0.12);\n    color: #023059;\n    border: 1px solid rgba(185, 94, 5, 0.25);\n  }\n  .oo-waitlist .oo-error {\n    background: rgba(255, 0, 0, 0.08);\n    color: #023059;\n    border: 1px solid rgba(255, 0, 0, 0.18);\n  }\n</style>\n\n<div class=\"oo-waitlist\" data-oo-waitlist>\n  <h3>Rx Obsidian Farsighted Lenses</h3>\n  <p>\n    Hyperopia (plus) lenses are in production. Join the waitlist and we will email you as soon as ordering opens.\n  </p>\n\n  {% form 'contact', id: 'ooObsidianHyperopiaWaitlist' %}\n    {% if form.posted_successfully? %}\n      <div class=\"oo-success\">You are on the list. We will email you as soon as it is available to order.</div>\n    {% elsif form.errors %}\n      <div class=\"oo-error\">{{ form.errors | default_errors }}</div>\n    {% endif %}\n\n    <details>\n      <summary>Join our waitlist</summary>\n\n      <div class=\"oo-waitlist-form\">\n        <div class=\"oo-waitlist-row\">\n          <input type=\"text\" name=\"contact[name]\" placeholder=\"Name\" autocomplete=\"name\" required>\n          <input type=\"email\" name=\"contact[email]\" placeholder=\"Email\" autocomplete=\"email\" required>\n        </div>\n\n        <input type=\"tel\" name=\"contact[phone]\" placeholder=\"Phone (optional)\" autocomplete=\"tel\">\n\n        <input type=\"hidden\" name=\"contact[tags]\" value=\"waitlist,rx-obsidian,farsighted,hyperopia\">\n\n        <textarea name=\"contact[body]\" id=\"ooWaitlistBody\" style=\"display:none;\"></textarea>\n\n        <button type=\"submit\">Notify me when ordering opens</button>\n        <small>Expected dispatch: late January to early February 2026 (subject to final production and QC). First batch may be limited.</small>\n      </div>\n    </details>\n  {% endform %}\n\n  <script type=\"application/json\" id=\"ooVariantsJson\">\n    {{ product.variants | json }}\n  </script>\n\n  <script>\n    (function () {\n      var body = document.getElementById('ooWaitlistBody');\n      var variantsScript = document.getElementById('ooVariantsJson');\n      if (!body || !variantsScript) return;\n\n      var variants = [];\n      try { variants = JSON.parse(variantsScript.textContent || '[]'); } catch (e) {}\n\n      function getSelectedVariantId() {\n        var idInput = document.querySelector('form[action*=\"/cart/add\"] input[name=\"id\"]');\n        return idInput ? idInput.value : '';\n      }\n\n      function findVariantTitleById(id) {\n        if (!id) return 'Not selected';\n        var vid = String(id);\n        var v = variants.find(function (x) { return String(x.id) === vid; });\n        if (!v) return 'Variant ID: ' + vid;\n        return v.title || ('Variant ID: ' + vid);\n      }\n\n      function updateMessage() {\n        var variantTitle = findVariantTitleById(getSelectedVariantId());\n        var msg = '';\n\n        msg += 'WAITLIST | RX OBSIDIAN | FARSIGHTED\\n\\n';\n        msg += 'Customer wants to be notified when ordering opens.\\n\\n';\n        msg += 'Product: {{ product.title | escape }}\\n';\n        msg += 'Variant: ' + variantTitle + '\\n';\n        msg += 'URL: {{ canonical_url }}\\n';\n        msg += 'ETA: Expected dispatch late January to early February 2026 (subject to final production and QC).\\n';\n        msg += 'Source: obsidian_farsighted_product_page\\n';\n\n        body.value = msg;\n      }\n\n      updateMessage();\n\n      document.addEventListener('change', function (e) {\n        if (!e.target) return;\n        if (e.target.name === 'id' || e.target.closest('variant-selects') || e.target.closest('variant-radios')) {\n          updateMessage();\n        }\n      });\n    })();\n  </script>\n</div>"
