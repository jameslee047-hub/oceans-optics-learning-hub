          "settings": {
            "custom_liquid": "<style>\n  /* Scoped to THIS Custom Liquid only */\n  #shopify-section-{{ section.id }} .oo-coupon{\n    display:flex;align-items:center;gap:10px;\n    padding:10px 12px;margin:8px 0 12px;\n    border:2px dashed #023059;border-radius:12px;background:#fff;color:#023059;\n    box-shadow:0 4px 14px rgba(2,48,89,.08);\n    font:600 16px/1.4 Lato,system-ui,sans-serif;max-width:520px;position:relative;\n  }\n  @supports ((-webkit-mask:linear-gradient(#000,#000)) or (mask:linear-gradient(#000,#000))){\n    #shopify-section-{{ section.id }} .oo-coupon{\n      -webkit-mask:\n        radial-gradient(12px at left center,transparent 98%,#000 100%) left/24px 100% no-repeat,\n        radial-gradient(12px at right center,transparent 98%,#000 100%) right/24px 100% no-repeat,\n        linear-gradient(#000,#000);\n              mask:\n        radial-gradient(12px at left center,transparent 98%,#000 100%) left/24px 100% no-repeat,\n        radial-gradient(12px at right center,transparent 98%,#000 100%) right/24px 100% no-repeat,\n        linear-gradient(#000,#000);\n    }\n  }\n  #shopify-section-{{ section.id }} .oo-chip{background:#B95E05;color:#fff;padding:2px 8px;border-radius:999px;font-weight:800;font-size:12px}\n  #shopify-section-{{ section.id }} .oo-text{margin:0;flex:1}\n  #shopify-section-{{ section.id }} .oo-code{font-weight:900;letter-spacing:.5px}\n  #shopify-section-{{ section.id }} .oo-btn{\n    border:1px solid #023059;background:#fff;color:#023059;\n    padding:6px 10px;border-radius:8px;font:700 13px/1 Lato,system-ui,sans-serif;cursor:pointer\n  }\n  #shopify-section-{{ section.id }} .oo-btn:hover{background:#023059;color:#fff}\n  #shopify-section-{{ section.id }} .oo-toast{\n    position:absolute;right:10px;top:-8px;transform:translateY(-100%);\n    background:#023059;color:#fff;border-radius:8px;padding:4px 8px;font:700 12px/1 Lato,system-ui,sans-serif;opacity:0;pointer-events:none;transition:.18s ease\n  }\n  #shopify-section-{{ section.id }} .oo-toast.show{opacity:1;transform:translateY(-110%)}\n  @media (max-width:749px){#shopify-section-{{ section.id }} .oo-coupon{font-size:15px}}\n</style>\n\n<div class=\"oo-coupon\" role=\"note\" aria-label=\"Discount code\">\n  <span class=\"oo-chip\">10% OFF</span>\n  <p class=\"oo-text\">Use code <span class=\"oo-code\" data-code=\"OCEAN10\">OCEAN10</span> at checkout.</p>\n  <button type=\"button\" class=\"oo-btn oo-copy\" aria-label=\"Copy discount code\">Copy</button>\n  <span class=\"oo-toast\" aria-hidden=\"true\">Copied</span>\n</div>\n\n<script>\n  (()=>{const root=document.getElementById('shopify-section-{{ section.id }}');\n    const coupon=root?.querySelector('.oo-coupon'); if(!coupon) return;\n    const btn=coupon.querySelector('.oo-copy'); const toast=coupon.querySelector('.oo-toast');\n    const code=(coupon.querySelector('.oo-code')?.textContent||'OCEAN10').trim();\n    btn?.addEventListener('click',async()=>{\n      try{await navigator.clipboard.writeText(code);}catch(e){}\n      toast.classList.add('show'); setTimeout(()=>toast.classList.remove('show'),1200);\n    });\n  })();\n</script>"
