      "settings": {
        "custom_liquid": "<div class=\"oo-review-grid\">\n  {%- comment -%} RX Obsidian {%- endcomment -%}\n  {%- assign p = all_products['the-rx-obsidian-prescription-mask-for-scuba-dive-snorkeling'] -%}\n  {%- if p -%}\n  <a class=\"oo-card\" href=\"{{ p.url }}#judgeme\">\n    <img src=\"{{ p.featured_image | img_url: '600x600' }}\" alt=\"{{ p.title | escape }}\">\n    <h3>{{ p.title }}</h3>\n    <span class=\"oo-btn\">Write review and add photo</span>\n  </a>\n  {%- endif -%}\n\n  {%- comment -%} RX Rover {%- endcomment -%}\n  {%- assign p = all_products['rx-rover-nearsighted-prescription-freediving-scuba-dive-mask'] -%}\n  {%- if p -%}\n  <a class=\"oo-card\" href=\"{{ p.url }}#review\">\n    <img src=\"{{ p.featured_image | img_url: '600x600' }}\" alt=\"{{ p.title | escape }}\">\n    <h3>{{ p.title }}</h3>\n    <span class=\"oo-btn\">Write review and add photo</span>\n  </a>\n  {%- endif -%}\n\n  {%- comment -%} RX Lumix {%- endcomment -%}\n  {%- assign p = all_products['professional-apollo-like-corrective-scuba-goggles-diving-aluminium-rx-optical-dive-mask-with-diopter-strength-from-1-5-to-6-0'] -%}\n  {%- if p -%}\n  <a class=\"oo-card\" href=\"{{ p.url }}#review\">\n    <img src=\"{{ p.featured_image | img_url: '600x600' }}\" alt=\"{{ p.title | escape }}\">\n    <h3>{{ p.title }}</h3>\n    <span class=\"oo-btn\">Write review and add photo</span>\n  </a>\n  {%- endif -%}\n</div>\n\n<style>\n/* Grid */\n.oo-review-grid{\n  display:grid; gap:14px;\n  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));\n  max-width:1100px; margin:0 auto;\n}\n\n/* Card layout (flex column so we can pin the button at the bottom) */\n.oo-card{\n  display:flex; flex-direction:column; align-items:center; text-align:center;\n  text-decoration:none; color:inherit;\n  border:1px solid #eee; border-radius:14px; padding:12px; background:#fff;\n  transition:transform .12s ease, box-shadow .12s ease;\n}\n.oo-card:hover{ transform:translateY(-2px); box-shadow:0 6px 18px rgba(0,0,0,.06); }\n\n/* Images: consistent square, no cropping */\n.oo-card img{\n  width:100% !important;\n  aspect-ratio:1 / 1 !important;\n  object-fit:contain !important;\n  background:#f6f8fb;\n  border-radius:12px;\n}\n\n/* Titles: clamp to exactly 3 lines so all cards line up */\n.oo-card h3{\n  margin:12px 0 8px;\n  line-height:1.3;\n  display:-webkit-box;\n  -webkit-line-clamp:3;               /* show up to 3 lines */\n  -webkit-box-orient:vertical;\n  overflow:hidden;\n  min-height:3.9em;                    /* 3 × 1.3 line-height */\n}\n\n/* Button: centered and pinned to the bottom of each card */\n.oo-btn{\n  margin-top:auto;                     /* pushes CTA to the bottom */\n  align-self:center;\n  display:inline-block;\n  padding:10px 14px;\n  border-radius:999px;\n  font-weight:700;\n  border:2px solid #B95E05;            /* orange outline */\n  background:#fff;                     /* white bg */\n  color:#B95E05;                       /* orange text */\n  transition:background .15s ease, color .15s ease, border-color .15s ease;\n}\n.oo-card:hover .oo-btn,\n.oo-btn:hover{\n  background:#B95E05;                  /* orange bg on hover */\n  color:#fff;                          /* white text on hover */\n  border-color:#B95E05;\n}\n\n/* Mobile polish */\n@media (max-width:480px){\n  .oo-card h3{ font-size:2rem; }\n}\n</style>",
