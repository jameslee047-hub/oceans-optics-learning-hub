        "collapsible_tab_WE8egq": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Product Description",
            "icon": "star",
            "content": "<p>Surface Marker Buoys (SMBs) are essential for diving safety, and SignalForce SMB is a game-changer for every diver, regardless of experience. At 1.2m (4 feet) in length, this high-visibility buoy provides the security you need in unexpected conditions. Whether navigating strong currents or surfacing in busy boat areas, the Ultimate Pro SMB ensures you’re a clear, unmissable beacon on the surface.</p><p>Crafted for durability and ease of use, this SMB is built with high-grade materials and features designed for both safety and convenience.</p>",
            "page": ""
          }
        },
        "collapsible_tab_gQbrjQ": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Fun Fact",
            "icon": "question_mark",
            "content": "<p><strong>Red or Orange SMB</strong>: Typically indicates a routine ascent, meaning the diver is surfacing as planned and doesn’t require immediate assistance. It’s the standard color for SMBs used in recreational diving as well.</p><p><strong>Yellow SMB</strong>: Often used to signal an emergency or request assistance. In technical diving, a yellow SMB means that the diver may need help, such as an issue with gas supply or other complications, and they may require immediate attention from the surface support.</p>",
            "page": ""
          }
        },
