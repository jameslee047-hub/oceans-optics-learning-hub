    "multicolumn_CYYGkg": {
      "type": "multicolumn",
      "blocks": {
        "column_F6JjRe": {
          "type": "column",
          "settings": {
            "title": "<strong>How Rx Lenses Work</strong>",
            "title_h3": true,
            "text": "<h4>Nearsighted diopter lenses move the focal point so distant objects snap into focus underwater. These optical corrective lenses are designed to improve clarity for divers with myopia and other distance vision challenges when using a nearsighted snorkel mask underwater.</h4><h4>Despite the name “Nearsighted,” they improve overall scene clarity across common dive distances by bending light toward the retina.</h4><h4>Because water makes objects appear larger and closer, many swimmers choose a slightly lower lens strength than their everyday glasses or reading prescription. Most prescription snorkel and scuba masks also use a flat lens design to maintain better underwater visibility.</h4>",
            "link_label": "",
            "link": ""
          }
        },
        "column_qBEXym": {
          "type": "column",
          "settings": {
            "title": "<strong>How To Choose Your Minus Lenses</strong>",
            "title_h3": true,
            "text": "<h4>1) Use the Sphere value from your latest prescription.</h4><h4>2) Select the closest minus power in 0.50 steps. Remember to round down toward 0!</h4><h4>3) Most divers go 0.25 to 0.50 weaker than their glasses due to water magnification. This helps many people find a more comfortable myopia lens strength underwater.</h4><h4>4) Choose each eye separately if your prescription type or Sphere values differ.</h4><h4>5) For more help, read our guide on how to choose the perfect lenses.</h4>",
            "link_label": "Read our blog for help finding your Rx lenses",
            "link": "shopify://blogs/home/round-up-or-down-choosing-the-right-lens-strength-for-your-underwater-adventure"
          }
        }
      },
      "block_order": [
        "column_F6JjRe",
