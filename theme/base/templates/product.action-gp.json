        "custom_liquid_QGa4e6": {
          "type": "custom_liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Rx Action</title>\n  <style>\n    /* --- Color Palette --- \n       Blue (text):   #023059\n       Orange (buttons): #B95E05\n    */\n\n    body {\n      margin: 0;\n      padding: 0;\n      font-family: Arial, sans-serif;\n      background: #f0f0f0;\n      color: #333;\n      line-height: 1.5;\n    }\n\n    .container {\n      max-width: 1200px;\n      margin: 40px auto;\n      padding: 0 20px;\n    }\n\n    .mask-grid {\n      display: grid;\n      grid-template-columns: repeat(1, 1fr);\n      gap: 20px;\n      max-width: 1200px;\n      margin: 0 auto;\n    }\n\n    /* Mask Card */\n    .mask-card {\n      background: #fff;\n      border: 1px solid #ddd;\n      border-radius: 6px;\n      overflow: hidden;\n      display: flex;\n      flex-direction: column;\n    }\n\n    .mask-image {\n      width: 95%;\n      height: 300px;\n      object-fit: cover;\n      background: #eee;\n      margin: 0 auto;\n    }\n\n    @media (max-width: 800px) {\n      .mask-image {\n        width: 95%;\n        height: auto;\n        object-fit: contain;\n      }\n    }\n\n    /* Card Content */\n    .card-content {\n      padding: 1rem;\n      flex: 1;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n    }\n\n    .mask-title {\n      font-weight: bold;\n      font-size: 1.1rem;\n      margin: 0 0 0.5rem;\n      color: #023059;\n    }\n\n    .size-category {\n      font-size: 0.9rem;\n      color: #666;\n      margin-bottom: 0.75rem;\n      font-style: italic;\n    }\n\n    /* Table */\n    .range-table {\n      width: 100%;\n      border-collapse: collapse;\n      margin: 0.1rem 0;\n    }\n    .range-table th,\n    .range-table td {\n      border: 1px solid #eee;\n      padding: 0.1rem;\n      text-align: center;\n      font-size: 0.9rem;\n    }\n    .range-table th {\n      background: #f9f9f9;\n      font-weight: bold;\n    }\n\n    .mask-notes {\n      font-size: 0.9rem;\n      color: #666;\n      margin-top: 0.5rem;\n    }\n\n    /* Buttons */\n    .btn {\n      display: inline-block;\n      margin-top: 0.5rem;\n      padding: 0.5rem 1rem;\n      border-radius: 4px;\n      text-decoration: none;\n      font-size: 0.9rem;\n      text-align: center;\n      cursor: pointer;\n      border: none;\n    }\n\n    .convert-btn {\n      background: #B95E05;\n      color: #fff;\n      margin-right: 1rem;\n    }\n    .convert-btn:hover {\n      background: #9a4e04;\n    }\n\n    .product-link {\n      background: #023059;\n      color: #fff;\n      text-decoration: none;\n    }\n    .product-link:hover {\n      background: #012345;\n    }\n  </style>\n</head>\n<body>\n\n<div class=\"container\">\n  <div class=\"mask-grid\" id=\"maskGrid\"></div>\n</div>\n\n<script>\nconst maskData = [\n  {\n    name: \"Rx Action\",\n    sizeCategory: \"Large\",\n    img: \"https://cdn.shopify.com/s/files/1/0798/8055/2781/files/prescription-dive-mask-new-rx-action-prescription-snorkel-mask-w-cam-mount-large-prescription-snorkel-mask-with-gopro-mount-black-large-face-2-00-farsighted-hyperopia-60876838076749.png?v=1731242688\",\n    link: \"https://oceansoptics.com/products/prescription-scuba-diving-mask-with-camera-mount\",\n    \n    currentUnits: \"cm\",\n    widthMinCM: 10.5, widthMaxCM: 12.5, widthOptCM: 11.25,\n    heightMinCM: 7.9, heightMaxCM: 10,  heightOptCM: 8.75,\n    widthMinIN: 4.13, widthMaxIN: 4.92, widthOptIN: 4.42,\n    heightMinIN: 3.11, heightMaxIN: 3.94, heightOptIN: 3.44,\n    notes: \"Lens: Near & Far. Black only with Action Camera Mount.\"\n  }\n];\n\nfunction renderAllCards() {\n  const grid = document.getElementById(\"maskGrid\");\n  grid.innerHTML = \"\";\n\n  maskData.forEach((mask, index) => {\n    const card = document.createElement(\"div\");\n    card.className = \"mask-card\";\n\n    const imgEl = document.createElement(\"img\");\n    imgEl.src = mask.img;\n    imgEl.alt = mask.name;\n    imgEl.className = \"mask-image\";\n\n    const contentDiv = document.createElement(\"div\");\n    contentDiv.className = \"card-content\";\n\n    const titleEl = document.createElement(\"div\");\n    titleEl.className = \"mask-title\";\n    titleEl.textContent = mask.name;\n\n    const sizeEl = document.createElement(\"div\");\n    sizeEl.className = \"size-category\";\n    sizeEl.textContent = `Size Category: ${mask.sizeCategory}`;\n\n    let wMin, wMax, wOpt, hMin, hMax, hOpt, label;\n    if (mask.currentUnits === \"cm\") {\n      wMin = mask.widthMinCM;\n      wMax = mask.widthMaxCM;\n      wOpt = mask.widthOptCM;\n      hMin = mask.heightMinCM;\n      hMax = mask.heightMaxCM;\n      hOpt = mask.heightOptCM;\n      label = \"cm\";\n    } else {\n      wMin = mask.widthMinIN;\n      wMax = mask.widthMaxIN;\n      wOpt = mask.widthOptIN;\n      hMin = mask.heightMinIN;\n      hMax = mask.heightMaxIN;\n      hOpt = mask.heightOptIN;\n      label = \"in\";\n    }\n\n    const table = document.createElement(\"table\");\n    table.className = \"range-table\";\n    table.innerHTML = `\n      <thead>\n        <tr>\n          <th></th>\n          <th>Min (${label})</th>\n          <th>Max (${label})</th>\n          <th>Optimal (${label})</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td><strong>Width</strong></td>\n          <td>${wMin}</td>\n          <td>${wMax}</td>\n          <td>${wOpt}</td>\n        </tr>\n        <tr>\n          <td><strong>Height</strong></td>\n          <td>${hMin}</td>\n          <td>${hMax}</td>\n          <td>${hOpt}</td>\n        </tr>\n      </tbody>\n    `;\n\n    const notesEl = document.createElement(\"div\");\n    notesEl.className = \"mask-notes\";\n    notesEl.textContent = mask.notes || \"\";\n\n    const btnContainer = document.createElement(\"div\");\n    const convertBtn = document.createElement(\"button\");\n    convertBtn.className = \"btn convert-btn\";\n    convertBtn.textContent = mask.currentUnits === \"cm\" \n      ? \"Switch to in\" \n      : \"Switch to cm\";\n    convertBtn.onclick = () => toggleUnits(index);\n\n    const linkEl = document.createElement(\"a\");\n    linkEl.href = mask.link;\n    linkEl.target = \"_blank\";\n    linkEl.className = \"btn product-link\";\n    linkEl.textContent = \"View Product\";\n\n    btnContainer.appendChild(convertBtn);\n    btnContainer.appendChild(linkEl);\n\n    contentDiv.appendChild(titleEl);\n    contentDiv.appendChild(sizeEl);\n    contentDiv.appendChild(table);\n    contentDiv.appendChild(notesEl);\n    contentDiv.appendChild(btnContainer);\n\n    card.appendChild(imgEl);\n    card.appendChild(contentDiv);\n\n    grid.appendChild(card);\n  });\n}\n\nfunction toggleUnits(index) {\n  maskData[index].currentUnits = (maskData[index].currentUnits === \"cm\") ? \"in\" : \"cm\";\n  renderAllCards();\n}\n\nrenderAllCards();\n</script>\n</body>\n</html>"
          }
        },
        "collapsible_tab_WE8egq": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Mask Description",
            "icon": "clipboard",
            "content": "<h5><strong>RX Action – Dive In with Confidence</strong></h5><h5>See more, swim longer, and enjoy every moment underwater with the RX Action mask — built for comfort, clarity, and real adventure.</h5><h5>Corrective lenses for nearsighted eyes mean you won’t miss a thing. Choose from our available strengths or mix and match for your perfect fit.<br/></h5><h5>Pick the exact lens powers you need from our dropdown — it's simple and tailored to you.<br/></h5><h5>The soft silicone skirt creates a gentle seal to keep water out — perfect for longer swims and bigger smiles.<br/></h5><h5>Easy to slip on and off, with no hair-pulling or adjusting mid-swim.<br/></h5><h5>Spacious without being bulky, this mask feels great from the first dive to the last.<br/></h5><h5>Want farsighted correction instead? <a href=\"https://oceansoptics.com/products/farsighted-prescription-diving-mask-snorkelling\">Check out the farsighted version here.</a></h5>",
            "page": ""
          }
        },
