        "collapsible_tab_H8fT3L": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Prescription Lens Info",
            "icon": "eye",
            "content": "<h5>This mask features nearsighted (SPH) lenses in negative diopters (e.g., -1.00, -1.75, -2.00).</h5><h5>Underwater magnification enlarges objects by ~33% – we recommend selecting a lens 0.25 to 0.75 diopters lower for optimal clarity. (e.g., a -2.75 can choose -2.50 or -2.00).</h5><h5>Tempered glass lenses for strength, safety, and clear underwater vision.</h5><h5>Need help? Chat with us live or email <a href=\"mailto:info@oceansoptics.com\" target=\"_blank\"><span style=\"text-decoration:underline\">info@oceansoptics.com</span></a></h5>",
            "page": ""
          }
        },
