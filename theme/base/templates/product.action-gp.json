    "multicolumn_nbRhUi": {
      "type": "multicolumn",
      "blocks": {
        "column_W4DAaX": {
          "type": "column",
          "disabled": true,
          "settings": {
            "title": "<strong>RX Action by Oceans Optics</strong>",
            "text": "<h5><strong>Ultimate Comfort</strong>: Our mask features a cutting-edge elastic headband for a snug, tangle-free fit.</h5><h5><strong>Snorkel-Ready</strong>: Equipped with a built-in holder to keep your snorkel in place and ready for action.</h5><h5><strong>Stay Secure</strong>: Our mask boasts a unique push-release strap system, ensuring a secure fit even in challenging conditions.</h5><h5><strong>Custom Fit:</strong> Designed with a spacious nose pocket to accommodate a variety of face shapes, providing a comfortable and leak-free seal.</h5><h5><strong>Skin-Friendly: </strong>Crafted from hypoallergenic food-grade liquid silicone, ensuring a safe and gentle experience on your skin.</h5><h5><strong>Capture Every Moment: </strong>Integrated action camera mount allows you to record your underwater adventures hands-free.</h5><h5><strong>Expert Guidance:</strong> Includes a complimentary guide to enhance your underwater exploration experience.</h5>",
            "link_label": "",
            "link": ""
          }
        },
        "column_3zCjnd": {
          "type": "column",
          "settings": {
            "title": "<strong>All Our Masks Have:</strong>",
            "text": "<h5>HD Tempered Glass (Scratch Proof) </h5><h5>Ultra clear lenses</h5><h5>Hypoallergenic liquid    silicone skirt </h5><h5>Double skirt edge comfort seal for leak-proof fit</h5><h5>Interchangeable lenses, to account for Prescription changes over time </h5>",
            "link_label": "Shop All Masks",
            "link": "shopify://collections/all-our-masks"
          }
        }
