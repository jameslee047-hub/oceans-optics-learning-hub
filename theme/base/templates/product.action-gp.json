    "rich_text_UWJUiq": {
      "type": "rich-text",
      "blocks": {
        "heading_gBfmQf": {
          "type": "heading",
          "settings": {
            "heading": "The RX Action by Oceans Optics",
            "heading_size": "h1"
          }
        },
        "text_UDtyit": {
          "type": "text",
          "settings": {
            "text": "<h5>Designed for those who crave both clarity and adventure, the <strong>RX Carbon Dive Mask</strong> offers precision vision and ultimate comfort for every dive. With <strong>RX-ready lenses</strong>, it’s easy to customize for crystal-clear underwater vision, whether you’re nearsighted or farsighted.</h5><h5>This mask is ideal for adventurers looking to <strong>document their underwater experience</strong>. The built-in <strong>action camera mount</strong> allows you to attach your GoPro or other action cameras, so you can effortlessly capture every breathtaking moment. Perfect for travel vloggers, underwater photographers, or anyone wanting to relive their dives with precision.</h5><h5>The <strong>elastic headband</strong> provides a comfortable, tangle-free fit, keeping your hair out of the way, while the <strong>silicone skirt</strong> ensures a secure, leak-proof seal no matter your face shape. Plus, the <strong>quick-release strap</strong> lets you easily adjust your fit, making it perfect for on-the-go dives.</h5>"
          }
        }
      },
