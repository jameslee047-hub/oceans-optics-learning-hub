        "collapsible_tab_xa3ifG": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Mask Description",
            "icon": "clipboard",
            "content": "<h5>The RX Carbon Dive Mask combines sleek styling with <strong>corrective vision</strong> support.</h5><h5>The fit is perfect for most <strong>Medium to Large</strong> face shapes. While the carbon-look frame adds a modern touch, its PU construction keeps it <strong>lightweight</strong> and <strong>durable</strong>. RX-ready lenses deliver <strong>sharp </strong>underwater <strong>clarity</strong>, and the soft silicone skirt ensures a <strong>comfortable</strong>, <strong>leak-proof fit</strong>. </h5><h5>The adjustable strap system makes securing the perfect seal simple, fitting most medium to large face shapes with ease.</h5><p></p>",
            "page": ""
          }
        },
        "collapsible_tab_e4re8m": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Prescription Lens info",
            "icon": "eye",
            "content": "<h5><strong>This mask features both Nearsighted & Farsighted (SPH) lenses in negative diopters (e.g., -1.50, -1.75, -2.00).</strong></h5><h5><strong>Underwater magnification enlarges objects by ~33% – we recommend selecting a lens 0.25 to 0.75 diopters lower for optimal clarity. </strong><em><strong>(e.g a Nearsighted-2.75 can choose -2.50 or -2.00 or a Farsighted +2.75 can choose +2.00).</strong></em></h5><h5><strong>Tempered glass lenses for strength, safety, and clear underwater vision.</strong></h5><h5><strong>Not sure? </strong><a href=\"/pages/prescription-lenses\" target=\"_blank\" title=\"FREE Lens calulator tool page\"><strong>Try our Exclusive Lens Matcher to find your perfect fit.</strong></a></h5><h5><strong>Need help? Chat with us live or email info@oceansoptics.com</strong></h5>",
            "page": ""
          }
        },
        "collapsible_tab_jHbD7U": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Mask Size Chart",
            "icon": "ruler",
