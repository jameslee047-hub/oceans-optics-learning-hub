          "type": "collapsible_tab",
          "settings": {
            "heading": "More than JUST Free Shipping",
            "icon": "truck",
            "content": "<h5>Orders $70+ ship free. Every order is carefully packed with quality guaranteed. Fast, trackable delivery in 3–10 days.</h5>",
            "page": ""
          }
        },
        "collapsible_tab_LyWcia": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "30 Day FREE Returns",
            "icon": "return",
            "content": "<h5>Take advantage of our 30 days from delivery FREE return policy—shop with confidence. See our full <a href=\"/pages/returns-and-warranty\" target=\"_blank\" title=\"Returns & Warranty\">return policy</a> for more infoa</h5>",
            "page": ""
          }
        },
        "collapsible_tab_z3GpTK": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "More than Just  a Mask",
            "icon": "heart",
            "content": "<h5>At <strong>Oceans Optics</strong>, we’re committed to <strong>clear vision and unforgettable underwater experiences</strong>. That’s why every order includes <strong>Snorkeling 101 – Your Ultimate Guide to Better Aquatic Adventures!</strong> </h5><h5>Get expert tips instantly after checkout or via email, and dive in with confidence.</h5>",
