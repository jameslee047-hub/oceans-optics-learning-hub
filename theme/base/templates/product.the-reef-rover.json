ion.id }} .oo-toast.show{opacity:1;transform:translateY(-110%)}\n  @media (max-width:749px){#shopify-section-{{ section.id }} .oo-coupon{font-size:15px}}\n</style>\n\n<div class=\"oo-coupon\" role=\"note\" aria-label=\"Discount code\">\n  <span class=\"oo-chip\">10% OFF</span>\n  <p class=\"oo-text\">Use code <span class=\"oo-code\" data-code=\"OCEAN10\">OCEAN10</span> at checkout.</p>\n  <button type=\"button\" class=\"oo-btn oo-copy\" aria-label=\"Copy discount code\">Copy</button>\n  <span class=\"oo-toast\" aria-hidden=\"true\">Copied</span>\n</div>\n\n<script>\n  (()=>{const root=document.getElementById('shopify-section-{{ section.id }}');\n    const coupon=root?.querySelector('.oo-coupon'); if(!coupon) return;\n    const btn=coupon.querySelector('.oo-copy'); const toast=coupon.querySelector('.oo-toast');\n    const code=(coupon.querySelector('.oo-code')?.textContent||'OCEAN10').trim();\n    btn?.addEventListener('click',async()=>{\n      try{await navigator.clipboard.writeText(code);}catch(e){}\n      toast.classList.add('show'); setTimeout(()=>toast.classList.remove('show'),1200);\n    });\n  })();\n</script>"
